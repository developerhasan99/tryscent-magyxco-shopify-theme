{%- comment -%}
  pm-bundle-save: "Bundle & Save" buy box (gallery left, box right from 990px, stacked below).
  Prices come from the bundle product's variants ("1 Bottle" ... "20 Bottles", mapped by the leading number).
  Scent rows come from the collection setting: one row per product that has an available variant
  titled like the "Bottle size" setting (default 50ml); that variant is what gets picked.
  Picks live in the Alpine component `pmBundleSave` below.
  Cart: mode bundle_product = one line (bundle variant for k bottles + "Bottle n" properties + _bundle_items),
  mode per_line = one line per scent (prices then need an automatic discount in admin).
  Styles: assets/pm-s-bundle-save.css, scoped under .pm-scope (section wrapper class from the schema).
{%- endcomment -%}
{%- liquid
  assign st = section.settings

  assign pm_bp = st.bundle_product
  if pm_bp == blank
    assign pm_bp = all_products['bundle-and-save']
  endif
  if pm_bp == blank and product != blank
    assign pm_bp = product
  endif

  assign pm_coll = st.collection
  if pm_coll == blank
    assign pm_coll = collections.all
  endif

  assign pm_size_label = st.bottle_size | default: '50ml' | strip
  assign pm_size_key = pm_size_label | downcase | remove: ' '

  # Per-bottle "was" price: 1-bottle variant's compare-at (converted by Markets), else the setting,
  # else the 1-bottle price itself (no invented saving)
  assign pm_single_cents = 0
  if st.single_price != blank
    assign pm_single_cents = st.single_price | times: 100 | round
  endif
  for v in pm_bp.variants
    assign vn = v.option1 | default: v.title | split: ' ' | first | plus: 0
    if vn == 1
      if v.compare_at_price > v.price
        assign pm_single_cents = v.compare_at_price
      elsif pm_single_cents == 0
        assign pm_single_cents = v.price
      endif
      break
    endif
  endfor

  # Variant map: leading number of option1 ("3 Bottles" -> 3) -> id / price / compare-at
  assign pm_vmax = 0
  assign pm_sep = ''
  capture pm_variants_json
    for v in pm_bp.variants
      assign vn = v.option1 | default: v.title | split: ' ' | first | plus: 0
      if vn < 1
        continue
      endif
      if vn > pm_vmax
        assign pm_vmax = vn
      endif
      assign v_compare = vn | times: pm_single_cents
      if v.compare_at_price > v.price
        assign v_compare = v.compare_at_price
      endif
      echo pm_sep
      echo '"' | append: vn | append: '":{"id":' | append: v.id | append: ',"price":' | append: v.price | append: ',"compare":' | append: v_compare | append: ',"available":' | append: v.available | append: '}'
      assign pm_sep = ','
    endfor
  endcapture

  # Tiers (block order), preselected index, overall cap
  assign pm_tier_start = -1
  assign pm_tier_count = 0
  assign pm_cap_max = 0
  assign pm_best_pct = 0
  assign pm_sep = ''
  capture pm_tiers_json
    for block in section.blocks
      if block.type != 'tier'
        continue
      endif
      assign t_bottles = block.settings.bottles | plus: 0
      assign t_cap = block.settings.max_bottles | plus: 0
      if t_cap < t_bottles
        assign t_cap = t_bottles
      endif
      if pm_vmax > 0 and t_cap > pm_vmax
        assign t_cap = pm_vmax
      endif
      if t_cap > pm_cap_max
        assign pm_cap_max = t_cap
      endif
      if block.settings.preselected and pm_tier_start == -1
        assign pm_tier_start = pm_tier_count
      endif
      echo pm_sep
      echo '{"bottles":' | append: t_bottles | append: ',"cap":' | append: t_cap | append: '}'
      assign pm_sep = ','
      assign pm_tier_count = pm_tier_count | plus: 1
    endfor
  endcapture
  if pm_tier_start == -1
    assign pm_tier_start = 0
  endif
  assign pm_max_total = pm_cap_max
  if pm_vmax > 0 and pm_max_total > pm_vmax
    assign pm_max_total = pm_vmax
  endif

  # Best saving over all variants, for the [max] token in the timer eyebrow
  for v in pm_bp.variants
    assign vn = v.option1 | default: v.title | split: ' ' | first | plus: 0
    if vn < 1
      continue
    endif
    assign v_compare = vn | times: pm_single_cents
    if v.compare_at_price > v.price
      assign v_compare = v.compare_at_price
    endif
    if v_compare > v.price
      assign v_pct = v_compare | minus: v.price | times: 100.0 | divided_by: v_compare | round
      if v_pct > pm_best_pct
        assign pm_best_pct = v_pct
      endif
    endif
  endfor

  # Start values for server-rendered text (the component takes over after init)
  assign pm_start_target = 0
  assign pm_i = 0
  for block in section.blocks
    if block.type != 'tier'
      continue
    endif
    if pm_i == pm_tier_start
      assign pm_start_target = block.settings.bottles | plus: 0
    endif
    assign pm_i = pm_i | plus: 1
  endfor

  assign pm_rating_score = st.rating_score | default: '4.9'

  # Optional line blocks: their product tags (a scent belongs to the first line whose tag it carries)
  # and oil text per line as "#KEY=|text" for the badge on each scent photo. Zero line blocks = no line step.
  assign pm_line_tags = ''
  assign pm_oil_map = ''
  for block in section.blocks
    if block.type != 'line'
      continue
    endif
    assign l_tag = block.settings.tag | strip
    if l_tag != blank
      assign pm_line_tags = pm_line_tags | append: l_tag | append: '|'
    endif
    if block.settings.oil != blank
      assign l_key = l_tag | default: 'CLASSIC'
      assign pm_oil_map = pm_oil_map | append: '#' | append: l_key | append: '=|' | append: block.settings.oil
    endif
  endfor
  assign pm_line_tag_list = pm_line_tags | split: '|'
  assign pm_oil_map = pm_oil_map | append: '#'
  assign pm_line_list = ''
  assign pm_row_count = 0
-%}

{%- comment -%} Scent rows, captured first so the line cards above can show per-line counts {%- endcomment -%}
{%- capture pm_rows -%}
  {%- paginate pm_coll.products by 250 -%}
    {%- for p in pm_coll.products -%}
      {%- liquid
        assign skip = false
        assign v = nil
        assign p_tags_low = p.tags | join: '|' | downcase | prepend: '|' | append: '|'
        if p.id == pm_bp.id
          assign skip = true
        elsif p_tags_low contains '|bundle|' or p_tags_low contains '|hide_bundle|'
          assign skip = true
        endif
        unless skip
          for pv in p.variants
            assign pv_key = pv.title | downcase | remove: ' '
            if pv.available and pv_key == pm_size_key
              assign v = pv
              break
            endif
          endfor
          if v == blank
            assign skip = true
          endif
        endunless
      -%}
      {%- unless skip -%}
        {%- liquid
          assign p_line = ''
          for lt in pm_line_tag_list
            if p.tags contains lt
              assign p_line = lt
              break
            endif
          endfor
          assign line_key = p_line | default: 'CLASSIC'
          assign pm_line_list = pm_line_list | append: '#' | append: line_key | append: '#'
          assign pm_row_count = pm_row_count | plus: 1

          # Gender from tags: men / for-men, women / for-women; both or none = Unisex
          assign g_men = false
          assign g_women = false
          if p_tags_low contains '|men|' or p_tags_low contains '|for-men|'
            assign g_men = true
          endif
          if p_tags_low contains '|women|' or p_tags_low contains '|for-women|'
            assign g_women = true
          endif
          assign p_gender = 'Unisex'
          if g_men and g_women == false
            assign p_gender = 'Men'
          elsif g_women and g_men == false
            assign p_gender = 'Women'
          endif

          # Gender pills (Men / Women / Unisex): the store's for-men / for-women collections (tag men / women)
          # and the unisex collection or tag. A unisex scent can sit under all three.
          assign p_sex = ''
          if g_men
            assign p_sex = p_sex | append: ' men'
          endif
          if g_women
            assign p_sex = p_sex | append: ' women'
          endif
          assign p_coll_handles = p.collections | map: 'handle'
          if p_tags_low contains '|unisex|' or p_coll_handles contains 'unisex'
            assign p_sex = p_sex | append: ' unisex'
          endif

          # Badge: "badge:<text>" tag wins, then the bestseller tag (red), then new / new-arrival (green)
          assign p_badge = ''
          assign p_badge_kind = ''
          assign p_best = false
          for t in p.tags
            assign t_low = t | downcase | strip
            assign t_head6 = t_low | slice: 0, 6
            if t_head6 == 'badge:' and p_badge == blank
              assign p_badge = t | strip | slice: 6, 60 | strip
            elsif t_low == 'bestseller'
              assign p_best = true
            endif
          endfor
          assign p_new = false
          if p_tags_low contains '|new|' or p_tags_low contains '|new-arrival|'
            assign p_new = true
          endif
          if p_badge == blank and p_best
            assign p_badge = st.bestseller_label | default: 'Bestseller'
            assign p_badge_kind = 'best'
          elsif p_badge == blank and p_new
            assign p_badge = st.new_label | default: 'New arrival'
            assign p_badge_kind = 'new'
          endif

          # Row name: "No. 247" from "Smells like... Le Male - No. 247", else the full title
          assign p_title = p.title | strip
          assign p_title_low = p_title | downcase
          assign p_name = p_title
          assign p_num = ''
          if p_title contains 'No.'
            assign p_num = p_title | split: 'No.' | last | strip
            if p_num != blank
              assign p_name = 'No. ' | append: p_num
            endif
          endif
          # Shown title (caps via CSS): a title that already is "<Name> - No. X" prints as is; a "Smells like..." title
          # gets the scent's own name from snippets/mgx-scent-name.liquid ("Toffee Embrace - No. 318"), else "No. X"
          assign p_scent_name = ''
          if p_num != blank
            capture p_scent_name
              render 'mgx-scent-name', number: p_num
            endcapture
            assign p_scent_name = p_scent_name | strip
          endif
          assign p_display = p_name
          if p_title_low contains 'smells like'
            if p_scent_name != blank
              assign p_display = p_scent_name | append: ' - ' | append: p_name
            endif
          else
            assign p_display = p_title
          endif

          # Designer twin: custom.inspiration metaobject name, else the title without "Smells like..." and the "- No. x" tail
          assign p_insp_img = p.metafields.custom.inspiration.value.image
          assign p_insp = p.metafields.custom.inspiration.value.name | strip
          if p_insp == blank
            assign p_insp = p_title
            assign p_head = p_title_low | slice: 0, 11
            if p_head == 'smells like'
              assign p_insp = p_title | slice: 11, 300 | strip
              assign p_head = p_insp | slice: 0, 3
              if p_head == '...'
                assign p_insp = p_insp | slice: 3, 300 | strip
              endif
              assign p_head = p_insp | slice: 0, 1
              if p_head == '…'
                assign p_insp = p_insp | slice: 1, 300 | strip
              endif
            endif
            if p_insp contains 'No.'
              assign p_insp_last = p_insp | split: 'No.' | last
              assign p_insp_tail = 'No.' | append: p_insp_last
              assign p_insp = p_insp | remove_last: p_insp_tail | strip
            endif
            assign p_insp_end = p_insp | slice: -1, 1
            if p_insp_end == '-'
              assign p_insp_cut = p_insp.size | minus: 1
              assign p_insp = p_insp | slice: 0, p_insp_cut | strip
            endif
          endif

          # Cart property value: "No. 247 (Le Male) · 50ml"
          assign p_cart = p_name
          if p_insp != blank
            assign p_cart = p_cart | append: ' (' | append: p_insp | append: ')'
          endif
          if pm_size_label != blank
            assign p_cart = p_cart | append: ' · ' | append: pm_size_label
          endif

          # Chip / search sources (the row script builds the chips): the reviewed facet map (assets/mgx-scent-facets.js),
          # else the occasion: / scent: tags, else the occasion and fragrance family fields
          assign p_occ_field = p.metafields.custom.occasion.value | strip
          assign p_fam_field = p.metafields.custom.fragrance_family.value | strip
          assign p_search = p_title | append: ' | ' | append: p_insp | append: ' ' | append: p_scent_name

          assign oil_token = '#' | append: line_key | append: '=|'
          assign p_oil = ''
          if pm_oil_map contains oil_token
            assign p_oil = pm_oil_map | split: oil_token | last | split: '#' | first | strip
          endif
        -%}
        <div
          class="pm-bs-row"
          role="listitem"
          data-pm-bs-row
          data-vid="{{ v.id }}"
          data-title="{{ p_cart | escape }}"
          data-line="{{ p_line | escape }}"
          data-handle="{{ p.handle | escape }}"
          data-sex="{{ p_sex | strip }}"
          data-search="{{ p_search | escape }}"
          data-tags="{{ p.tags | join: '|' | escape }}"
          data-occ-field="{{ p_occ_field | escape }}"
          data-fam-field="{{ p_fam_field | escape }}"
          x-show="rowOk('{{ v.id }}')"
          :class="{ 'is-picked': qty({{ v.id }}) > 0 }"
        >
          <div class="pm-bs-row__side">
            {%- if p_oil != blank -%}
              <span class="pm-bs-row__oil">{{ p_oil | escape }}</span>
            {%- endif -%}
            <div class="pm-bs-row__media">
              {%- if p.featured_image != blank -%}
                {{ p.featured_image | image_url: width: 280 | image_tag: width: 140, height: 140, widths: '140, 280', sizes: '72px', loading: 'lazy', alt: p_title, class: 'pm-bs-row__img' }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'pm-bs-row__img' }}
              {%- endif -%}
            </div>
            <span class="pm-bs-row__for">{{ p_gender }}</span>
          </div>
          <div class="pm-bs-row__body">
            <p class="pm-bs-row__title">{{ p_display | escape }}</p>
            {%- if p_insp != blank -%}
              <p class="pm-bs-row__insp">
                {%- if p_insp_img != blank -%}
                  <span class="pm-bs-row__insp-img"><img src="{{ p_insp_img | image_url: width: 90, height: 90 }}" alt="" width="28" height="28" loading="lazy" decoding="async"></span>
                {%- endif -%}
                <span>{{ st.inspired_prefix | escape }} <strong>{{ p_insp | escape }}</strong></span>
              </p>
            {%- endif -%}
            <ul class="pm-bs-row__tags" role="list" data-pm-bs-chips hidden></ul>
          </div>
          <div class="pm-bs-row__actions">
            {%- if p_badge != blank -%}
              <span class="pm-bs-row__badge{% if p_badge_kind != blank %} pm-bs-row__badge--{{ p_badge_kind }}{% endif %}">{{ p_badge | escape }}</span>
            {%- endif -%}
            <button
              type="button"
              class="pm-btn pm-btn--primary pm-btn--mini pm-bs-add"
              x-show="qty({{ v.id }}) === 0"
              :disabled="atMax"
              @click="add({{ v.id }})"
              aria-label="{{ 'premium.pdp.add_product' | t: name: p_cart | escape }}"
            >
              {{ st.add_label | escape }}
            </button>
            <div class="pm-bs-step" x-show="qty({{ v.id }}) > 0" x-cloak>
              <button type="button" class="pm-bs-step__btn" @click="remove({{ v.id }})" aria-label="{{ 'premium.pdp.remove_product' | t: name: p_cart | escape }}">
                {%- render 'pm-icon', icon: 'minus', size: 14, stroke: 2 -%}
              </button>
              <span class="pm-bs-step__qty" x-text="qty({{ v.id }})">0</span>
              <button type="button" class="pm-bs-step__btn" @click="add({{ v.id }})" :disabled="atMax" aria-label="{{ 'premium.pdp.add_product' | t: name: p_cart | escape }}">
                {%- render 'pm-icon', icon: 'plus', size: 14, stroke: 2 -%}
              </button>
            </div>
          </div>
        </div>
      {%- endunless -%}
    {%- endfor -%}
  {%- endpaginate -%}
{%- endcapture -%}

{%- liquid
  # Lines: config + per-line row counts (stays empty with zero line blocks)
  assign pm_line_start = -1
  assign pm_line_idx = 0
  assign pm_sep = ''
  capture pm_lines_json
    for block in section.blocks
      if block.type != 'line'
        continue
      endif
      assign l_tag = block.settings.tag | strip
      assign l_key = l_tag | default: 'CLASSIC'
      assign l_token = '#' | append: l_key | append: '#'
      assign l_rest = pm_line_list | remove: l_token
      assign l_count = pm_line_list.size | minus: l_rest.size | divided_by: l_token.size
      if block.settings.preselected and pm_line_start == -1
        assign pm_line_start = pm_line_idx
      endif
      assign l_tag_json = l_tag | json
      echo pm_sep
      echo '{"tag":' | append: l_tag_json | append: ',"count":' | append: l_count | append: '}'
      assign pm_sep = ','
      assign pm_line_idx = pm_line_idx | plus: 1
    endfor
  endcapture

  # Figtree ships only at 400 in layout/theme.liquid; the box uses 500/600/800 too
  assign pm_bs_f500 = settings.type_header_font | font_modify: 'weight', '500'
  assign pm_bs_f600 = settings.type_header_font | font_modify: 'weight', '600'
  assign pm_bs_f800 = settings.type_header_font | font_modify: 'weight', '800'
-%}

{%- style -%}
  {%- if pm_bs_f500 != blank -%}{{ pm_bs_f500 | font_face: font_display: 'swap' }}{%- endif -%}
  {%- if pm_bs_f600 != blank -%}{{ pm_bs_f600 | font_face: font_display: 'swap' }}{%- endif -%}
  {%- if pm_bs_f800 != blank -%}{{ pm_bs_f800 | font_face: font_display: 'swap' }}{%- endif -%}
{%- endstyle -%}

{{ 'pm-bs-base.css' | asset_url | stylesheet_tag }}
{{ 'pm-s-bundle-save.css' | asset_url | stylesheet_tag }}

<section
  id="PmBundleSave-{{ section.id }}"
  class="pm-bs color-{{ st.color_scheme }} gradient"
  x-data="pmBundleSave"
  data-section-id="{{ section.id }}"
>
  <script type="application/json" data-pm-bs-config>
    {
      "tiers": [{{ pm_tiers_json }}],
      "tierStart": {{ pm_tier_start }},
      "lines": [{{ pm_lines_json }}],
      "lineStart": {{ pm_line_start }},
      "rowCount": {{ pm_row_count }},
      "variants": { {{ pm_variants_json }} },
      "maxTotal": {{ pm_max_total }},
      "mode": {{ st.pricing_mode | json }},
      "moneyFormat": {{ shop.money_format | json }},
      "timerOn": {{ st.show_timer }},
      "timerHours": {{ st.timer_hours | default: 24 }},
      "reviewMs": {{ st.review_interval | default: 5 | times: 1000 }},
      "rewardsOn": {{ st.show_rewards }},
      "text": {
        "rwShippingAway": {{ st.rewards_shipping_away | json }},
        "rwGiftAway": {{ st.rewards_gift_away | json }},
        "rwDonePreview": {{ st.rewards_done_preview | json }},
        "rwDone": {{ st.rewards_done | json }},
        "rwDoneShipping": {{ st.rewards_done_shipping | json }},
        "rwShippingLabel": {{ st.rewards_shipping_label | json }},
        "rwGiftLabel": {{ st.rewards_gift_label | json }},
        "scentsHeading": {{ st.scents_heading | json }},
        "counter": {{ st.counter_text | json }},
        "remaining": {{ st.remaining_text | json }},
        "max": {{ st.max_text | json }},
        "linePicked": {{ st.line_picked_text | json }},
        "ctaEmpty": {{ st.cta_empty | json }},
        "cta": {{ st.cta_label | json }},
        "adding": {{ st.cta_adding | json }},
        "error": {{ st.error_text | json }},
        "bottle": {{ st.bottle_property | json }}
      }
    }
  </script>

  <div class="page-width pm-bs__grid">
    {%- comment -%} 1. Gallery: the bundle product's media, scroll-snap track + thumbnails {%- endcomment -%}
    <div class="pm-bs__media">
      <div class="pm-bs-gallery">
        <div class="pm-bs-gallery__viewport">
          <div class="pm-bs-gallery__track" x-ref="track" @scroll.passive="onTrack()">
            {%- assign pm_media_count = 0 -%}
            {%- for media in pm_bp.media -%}
              {%- if media.preview_image == blank -%}{%- continue -%}{%- endif -%}
              {%- assign pm_media_count = pm_media_count | plus: 1 -%}
              {%- assign pm_alt = media.alt | default: pm_bp.title -%}
              <div class="pm-bs-gallery__slide">
                {%- if forloop.first -%}
                  {{ media.preview_image | image_url: width: 1400 | image_tag: widths: '375, 550, 750, 1100, 1400', sizes: '(min-width: 990px) 50vw, 100vw', fetchpriority: 'high', loading: 'eager', alt: pm_alt, class: 'pm-bs-gallery__img' }}
                {%- else -%}
                  {{ media.preview_image | image_url: width: 1400 | image_tag: widths: '375, 550, 750, 1100, 1400', sizes: '(min-width: 990px) 50vw, 100vw', loading: 'lazy', alt: pm_alt, class: 'pm-bs-gallery__img' }}
                {%- endif -%}
              </div>
            {%- endfor -%}
            {%- if pm_media_count == 0 -%}
              <div class="pm-bs-gallery__slide">{{ 'product-1' | placeholder_svg_tag: 'pm-bs-gallery__img' }}</div>
            {%- endif -%}
          </div>
          {%- if pm_media_count > 1 -%}
            <button type="button" class="pm-bs-gallery__arrow pm-bs-gallery__arrow--prev" @click="goTo(media - 1)" :disabled="media === 0" aria-label="{{ 'premium.general.previous' | t }}">
              {%- render 'pm-icon', icon: 'chevron-right', size: 16 -%}
            </button>
            <button type="button" class="pm-bs-gallery__arrow pm-bs-gallery__arrow--next" @click="goTo(media + 1)" :disabled="media === {{ pm_media_count | minus: 1 }}" aria-label="{{ 'premium.general.next' | t }}">
              {%- render 'pm-icon', icon: 'chevron-right', size: 16 -%}
            </button>
          {%- endif -%}
        </div>
        {%- if pm_media_count > 1 -%}
          <div class="pm-bs-gallery__thumbs">
            {%- assign pm_mi = 0 -%}
            {%- for media in pm_bp.media -%}
              {%- if media.preview_image == blank -%}{%- continue -%}{%- endif -%}
              <button
                type="button"
                class="pm-bs-gallery__thumb{% if pm_mi == 0 %} is-active{% endif %}"
                :class="{ 'is-active': media === {{ pm_mi }} }"
                @click="goTo({{ pm_mi }})"
                aria-label="{{ pm_bp.title | escape }} {{ pm_mi | plus: 1 }}"
              >
                {{ media.preview_image | image_url: width: 160 | image_tag: width: 80, height: 80, loading: 'lazy', alt: '' }}
              </button>
              {%- assign pm_mi = pm_mi | plus: 1 -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>

    <div class="pm-bs__box">
      {%- comment -%} 2. Rating, headline, subheading, benefits {%- endcomment -%}
      <div class="pm-bs-intro">
        {%- if st.rating_text != blank -%}
          <div class="pm-bs-rating">
            {%- render 'pm-stars', rating: pm_rating_score, size: 14 -%}
            <span class="pm-bs-rating__label">{{ st.rating_label | escape }} {{ pm_rating_score | escape }}</span>
            <span class="pm-bs-rating__sep" aria-hidden="true">|</span>
            {%- if st.rating_link != blank -%}
              <a class="pm-bs-rating__link" href="{{ st.rating_link }}">{{ st.rating_text | escape }}</a>
            {%- else -%}
              <span>{{ st.rating_text | escape }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- if st.headline != blank -%}
          <h1 class="pm-bs-headline">{{ st.headline }}</h1>
        {%- endif -%}
        {%- if st.subheading != blank -%}
          <p class="pm-bs-sub">{{ st.subheading }}</p>
        {%- endif -%}
        <ul class="pm-bs-benefits">
          {%- for block in section.blocks -%}
            {%- if block.type == 'benefit' and block.settings.text != blank -%}
              <li class="pm-bs-benefits__item" {{ block.shopify_attributes }}>
                {%- render 'pm-icon', icon: block.settings.icon, size: 20, stroke: 1.5, class: 'pm-bs-benefits__icon' -%}
                <span>{{ block.settings.text | escape }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

      {%- comment -%} 3. Evergreen countdown {%- endcomment -%}
      {%- if st.show_timer -%}
        <div class="pm-bs-timer" role="timer"{% if st.timer_label != blank %} aria-label="{{ st.timer_label | escape }}"{% endif %}>
          <div class="pm-bs-timer__text">
            {%- if st.timer_eyebrow != blank -%}
              {%- liquid
                comment
                  The part before the first "·" is the offer ("Up to 40% off") and renders as the bold lead-in
                endcomment
                assign pm_eyebrow = st.timer_eyebrow | replace: '[max]', pm_best_pct | escape | split: '·'
              -%}
              <p class="pm-bs-timer__eyebrow">
                {%- for seg in pm_eyebrow -%}
                  {%- assign seg_text = seg | strip -%}
                  {%- if forloop.first -%}
                    <span class="pm-bs-timer__seg pm-bs-timer__sale">{{ seg_text }}</span>
                  {%- else -%}
                    {{ ' ' }}<span class="pm-bs-timer__seg">· {{ seg_text }}</span>
                  {%- endif -%}
                {%- endfor -%}
              </p>
            {%- endif -%}
            <p class="pm-bs-timer__title">{{ st.timer_title | escape }}</p>
          </div>
          <div class="pm-bs-timer__clock" aria-live="off">
            <div class="pm-bs-timer__unit">
              <span class="pm-bs-timer__num" x-text="clock.h">{{ st.timer_hours | default: 24 | prepend: '0' | slice: -2, 2 }}</span>
              <span class="pm-bs-timer__lbl">{{ st.timer_hrs_label | escape }}</span>
            </div>
            <div class="pm-bs-timer__unit">
              <span class="pm-bs-timer__num" x-text="clock.m">00</span>
              <span class="pm-bs-timer__lbl">{{ st.timer_mins_label | escape }}</span>
            </div>
            <div class="pm-bs-timer__unit">
              <span class="pm-bs-timer__num" x-text="clock.s">00</span>
              <span class="pm-bs-timer__lbl">{{ st.timer_secs_label | escape }}</span>
            </div>
          </div>
        </div>
      {%- endif -%}

      {%- comment -%} 4. Tier cards {%- endcomment -%}
      {%- if pm_tier_count > 0 -%}
        <div class="pm-bs-group">
          {%- if st.tiers_heading != blank -%}
            <h2 class="pm-bs-h">{{ st.tiers_heading | escape }}</h2>
          {%- endif -%}
          <div class="pm-bs-tiers">
            {%- assign ti = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type != 'tier' -%}{%- continue -%}{%- endif -%}
              {%- liquid
                assign t_bottles = block.settings.bottles | plus: 0
                assign t_max = block.settings.max_bottles | plus: 0
                assign t_price = 0
                assign t_max_price = 0
                assign t_max_n = 0
                assign t_compare = t_bottles | times: pm_single_cents
                for v in pm_bp.variants
                  assign vn = v.option1 | default: v.title | split: ' ' | first | plus: 0
                  if vn == t_bottles
                    assign t_price = v.price
                    if v.compare_at_price > v.price
                      assign t_compare = v.compare_at_price
                    endif
                  elsif vn > t_bottles and vn <= t_max and vn > t_max_n
                    assign t_max_n = vn
                    assign t_max_price = v.price
                  endif
                endfor
                assign t_each = ''
                if t_price > 0 and t_bottles > 0 and st.per_bottle_text != blank
                  assign t_each_money = t_price | divided_by: t_bottles | money_without_trailing_zeros
                  assign t_each = st.per_bottle_text | replace: '[price]', t_each_money
                endif
                assign t_stack = ''
                if t_max_price > t_price and t_price > 0 and st.stack_text != blank
                  assign t_extra_money = t_max_price | minus: t_price
                  assign t_extra_n = t_max_n | minus: t_bottles
                  assign t_extra_money = t_extra_money | divided_by: t_extra_n | money_without_trailing_zeros
                  assign t_stack = st.stack_text | replace: '[price]', t_extra_money
                endif
                assign t_badge = block.settings.badge_override | strip
                if t_badge == blank and t_price > 0 and t_compare > t_price
                  assign t_pct = t_compare | minus: t_price | times: 100.0 | divided_by: t_compare | round
                  assign t_badge = t_pct | append: '% OFF'
                endif
              -%}
              <button
                type="button"
                class="pm-bs-tier{% if ti == pm_tier_start %} is-selected{% endif %}"
                :class="{ 'is-selected': tierIndex === {{ ti }} }"
                aria-pressed="{% if ti == pm_tier_start %}true{% else %}false{% endif %}"
                :aria-pressed="tierIndex === {{ ti }} ? 'true' : 'false'"
                @click="selectTier({{ ti }})"
                {{ block.shopify_attributes }}
              >
                {%- if t_badge != blank -%}
                  <span class="pm-bs-tier__badge">{{ t_badge | escape }}</span>
                {%- endif -%}
                <span class="pm-bs-tier__check" aria-hidden="true">{%- render 'pm-icon', icon: 'check', size: 12, stroke: 2.5 -%}</span>
                <span class="pm-bs-tier__label">{{ block.settings.label | escape }}</span>
                {%- if block.settings.tag != blank -%}
                  <span class="pm-bs-tier__tag">{{ block.settings.tag | escape }}</span>
                {%- endif -%}
                <span class="pm-bs-tier__prices">
                  {%- if t_price > 0 -%}
                    <span
                      class="pm-bs-tier__price"
                      {% if t_max_n > t_bottles %}x-text="liveTier({{ ti }}) ? money(liveTier({{ ti }}).price) : {{ t_price | money_without_trailing_zeros | json | escape }}"{% endif %}
                    >{{ t_price | money_without_trailing_zeros }}</span>
                  {%- endif -%}
                  {%- if t_compare > t_price -%}
                    <s
                      class="pm-bs-tier__compare"
                      {% if t_max_n > t_bottles %}x-text="liveTier({{ ti }}) ? money(liveTier({{ ti }}).compare) : {{ t_compare | money_without_trailing_zeros | json | escape }}"{% endif %}
                    >{{ t_compare | money_without_trailing_zeros }}</s>
                  {%- endif -%}
                </span>
                {%- if t_each != blank -%}
                  <span class="pm-bs-tier__each">{{ t_each | escape }}</span>
                {%- endif -%}
                {%- if t_stack != blank -%}
                  <span class="pm-bs-tier__stack">{{ t_stack | escape }}</span>
                {%- endif -%}
              </button>
              {%- assign ti = ti | plus: 1 -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- comment -%} 5. Line filter: renders only when the section has line blocks {%- endcomment -%}
      {%- if pm_line_idx > 0 -%}
        <div class="pm-bs-group">
          {%- if st.lines_heading != blank -%}
            <h2 class="pm-bs-h">{{ st.lines_heading | escape }}</h2>
          {%- endif -%}
          <div class="pm-bs-lines" style="--pm-bs-lines: {{ pm_line_idx }};">
            {%- assign li = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type != 'line' -%}{%- continue -%}{%- endif -%}
              {%- liquid
                assign l_tag = block.settings.tag | strip
                assign l_key = l_tag | default: 'CLASSIC'
                assign l_token = '#' | append: l_key | append: '#'
                assign l_rest = pm_line_list | remove: l_token
                assign l_count = pm_line_list.size | minus: l_rest.size | divided_by: l_token.size
              -%}
              <button
                type="button"
                class="pm-bs-line{% if li == pm_line_start %} is-selected{% endif %}"
                :class="{ 'is-selected': lineIndex === {{ li }} }"
                aria-pressed="{% if li == pm_line_start %}true{% else %}false{% endif %}"
                :aria-pressed="lineIndex === {{ li }} ? 'true' : 'false'"
                @click="toggleLine({{ li }})"
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.badge != blank -%}
                  <span class="pm-bs-line__badge">{{ block.settings.badge | escape }}</span>
                {%- endif -%}
                <span class="pm-bs-line__label">{{ block.settings.label | escape }}</span>
                {%- assign l_strength = block.settings.strength | default: 0 -%}
                {%- if l_strength > 0 -%}
                  <span class="pm-bs-line__dots" aria-hidden="true">
                    {%- for d in (1..3) -%}
                      <span class="pm-bs-line__dot{% if d <= l_strength %} is-on{% endif %}"></span>
                    {%- endfor -%}
                  </span>
                {%- endif -%}
                {%- if block.settings.oil != blank or block.settings.longevity != blank -%}
                  <span class="pm-bs-line__spec">
                    {%- if block.settings.oil != blank -%}<span>{{ block.settings.oil | escape }}</span>{%- endif -%}
                    {%- if block.settings.longevity != blank -%}<span>{{ block.settings.longevity | escape }}</span>{%- endif -%}
                  </span>
                {%- endif -%}
                {%- if block.settings.subtext != blank -%}
                  <span class="pm-bs-line__sub">{{ block.settings.subtext | replace: '[count]', l_count | escape }}</span>
                {%- endif -%}
                <span class="pm-bs-line__picked" x-show="lineCount({{ li }}) > 0" x-text="linePickedText({{ li }})" x-cloak></span>
              </button>
              {%- assign li = li | plus: 1 -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- comment -%} 6. Scent picker {%- endcomment -%}
      <div class="pm-bs-group pm-bs-scents">
        <div class="pm-bs-scents__head">
          <h2 class="pm-bs-h" x-text="scentsHeading">{{ st.scents_heading | replace: '[n]', pm_start_target | escape }}</h2>
          <span class="pm-bs-scents__count" aria-live="polite" x-text="counterText">{{ st.counter_text | replace: '[x]', '0' | replace: '[n]', pm_start_target | escape }}</span>
        </div>
        <div class="pm-bs-progress" aria-hidden="true" x-show="!rewards">
          <span class="pm-bs-progress__bar" :style="{ width: percent + '%' }"></span>
        </div>
        {%- if st.show_rewards -%}
          {%- comment -%}
            Cart rewards bar: the thresholds of the store's Kite "Goal Based" progress bar (the cart drawer's bar) for the
            visitor's market and currency, read from the Kite app embed at runtime. Counts the cart plus the bundle being
            built until exactly these picks are in the cart. Without an active Kite goal the plain progress bar stays.
          {%- endcomment -%}
          <div class="pm-bs-rw" x-show="rewards" x-cloak>
            <template x-if="rewards">
              <div>
                <p class="pm-bs-rw__msg" :class="{ 'is-done': rewards.done }" x-html="rewards.msg" aria-live="polite"></p>
                <div class="pm-bs-rw__bar" :style="'--pm-bs-rw-n: ' + rewards.steps.length">
                  <div class="pm-bs-rw__track" aria-hidden="true"><span class="pm-bs-rw__fill" :style="'width: ' + rewards.pct + '%'"></span></div>
                  <ol class="pm-bs-rw__steps" role="list">
                    <template x-for="(s, i) in rewards.steps" :key="i">
                      <li class="pm-bs-rw__step" :class="{ 'is-on': s.on }">
                        <span class="pm-bs-rw__dot" aria-hidden="true">
                          <svg x-show="s.on" viewBox="0 0 12 10" width="12" height="10" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M1 5l3.5 3.5L11 1"/></svg>
                          <svg x-show="!s.on && s.kind === 'shipping'" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" focusable="false"><path d="M2 6h12v10H2zM14 10h4l3 3v3h-7"/><circle cx="6" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></svg>
                          <svg x-show="!s.on && s.kind !== 'shipping'" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" focusable="false"><path d="M4 11h16v10H4zM3 7h18v4H3zM12 7v14M12 7C10.5 4 7 3.5 7 6s3 1 5 1zm0 0c1.5-3 5-3.5 5-1s-3 1-5 1z"/></svg>
                        </span>
                        <b x-text="s.amount"></b>
                        <span x-text="s.label"></span>
                      </li>
                    </template>
                  </ol>
                </div>
              </div>
            </template>
          </div>
        {%- endif -%}
        <p class="pm-bs-hint" x-show="hintText" x-text="hintText" x-cloak></p>
        {%- if st.show_filters -%}
          <div class="pm-bs-find" role="search">
            <div class="pm-bs-find__field">
              <svg class="pm-bs-find__ico" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.6-3.6"/></svg>
              <input
                class="pm-bs-find__input"
                type="search"
                x-ref="find"
                placeholder="{{ st.search_placeholder | escape }}"
                aria-label="{{ st.search_placeholder | escape }}"
                autocomplete="off"
                autocapitalize="off"
                autocorrect="off"
                spellcheck="false"
                enterkeyhint="search"
                @input="onFindInput($event.target.value)"
                @keydown.escape="onFindEscape($event)"
                @keydown.enter.prevent="onFindEnter($event)"
              >
              <button type="button" class="pm-bs-find__clear" aria-label="{{ st.search_clear_label | escape }}" x-show="findText" x-cloak @click="setFind(''); $refs.find.focus()">&times;</button>
            </div>
            <div class="pm-bs-find__pills" role="group" aria-label="{{ st.filter_group_label | escape }}">
              <button type="button" class="pm-bs-find__pill" aria-pressed="true" :aria-pressed="sex === '' ? 'true' : 'false'" @click="sex = ''">{{ st.filter_all_label | escape }}</button>
              <button type="button" class="pm-bs-find__pill" aria-pressed="false" :aria-pressed="sex === 'men' ? 'true' : 'false'" @click="sex = 'men'">{{ st.filter_men_label | escape }}</button>
              <button type="button" class="pm-bs-find__pill" aria-pressed="false" :aria-pressed="sex === 'women' ? 'true' : 'false'" @click="sex = 'women'">{{ st.filter_women_label | escape }}</button>
              <button type="button" class="pm-bs-find__pill" aria-pressed="false" :aria-pressed="sex === 'unisex' ? 'true' : 'false'" @click="sex = 'unisex'">{{ st.filter_unisex_label | escape }}</button>
            </div>
          </div>
        {%- endif -%}
        <script src="{{ 'mgx-scent-facets.js' | asset_url }}"></script>
        <div class="pm-bs-list" x-ref="list" @scroll.passive="checkScroll()" role="list" :class="{ 'is-empty': visibleRows === 0 }" data-pm-bs-list>
          {{ pm_rows }}
        </div>
        <script>
          (function () {
            /* Row chips, built before first paint (the component runs this again after a theme editor re-render):
               the most specific occasion + the scent family, two chips at most (two families when there is no
               occasion). Source per scent: the reviewed facet map (assets/mgx-scent-facets.js, same values as the Whop
               store), else the occasion: / scent: tags, else the Occasion / Fragrance Family fields. Missing = no chip.
               Every occasion and family label also goes to data-chip-words for the search. */
            if (!window.pmBsChips) {
              var OCC = [['date-night', 'Date Night'], ['night-out', 'Night Out'], ['weddings-events', 'Weddings & Events'], ['special-occasion', 'Special occasion'], ['sport-fresh', 'Sport & Fresh'], ['work-office', 'Work & Office'], ['vacations-summer', 'Vacations & Summer'], ['weekend-chill', 'Weekend & Chill'], ['everyday', 'Everyday'], ['daily-signature', 'Daily Signature']];
              var FAM = { 'aquatic-marine': 'Aquatic & Marine', 'aromatic-green': 'Aromatic & Green', 'floral': 'Floral', 'fresh-citrus': 'Fresh & Citrus', 'fruity': 'Fruity', 'gourmand': 'Gourmand', 'warm-spicy': 'Warm & Spicy', 'woody-earthy': 'Woody & Earthy' };
              var TAG_OCC = { 'date-night': 'date-night', 'date': 'date-night', 'evening': 'night-out', 'special': 'special-occasion', 'formal': 'special-occasion', 'sport': 'sport-fresh', 'office': 'work-office', 'everyday': 'everyday' };
              var TAG_FAM = { 'aquatic': 'aquatic-marine', 'aromatic': 'aromatic-green', 'fougere': 'aromatic-green', 'floral': 'floral', 'fresh': 'fresh-citrus', 'citrus': 'fresh-citrus', 'fruity': 'fruity', 'gourmand': 'gourmand', 'oriental': 'warm-spicy', 'spicy': 'warm-spicy', 'woody': 'woody-earthy', 'leather': 'woody-earthy' };
              var FIELD_OCC = { 'evening': 'night-out', 'date': 'date-night', 'date night': 'date-night', 'daytime': 'everyday', 'everyday': 'everyday', 'formal': 'special-occasion', 'special': 'special-occasion', 'office/work': 'work-office', 'office': 'work-office', 'sport': 'sport-fresh' };
              var FIELD_FAM = { 'oriental': 'warm-spicy', 'spicy': 'warm-spicy', 'amber': 'warm-spicy', 'woody': 'woody-earthy', 'leather': 'woody-earthy', 'gourmand': 'gourmand', 'floral': 'floral', 'fresh': 'fresh-citrus', 'citrus': 'fresh-citrus', 'aquatic/marine': 'aquatic-marine', 'aquatic': 'aquatic-marine', 'fruity': 'fruity', 'aromatic': 'aromatic-green', 'fougere': 'aromatic-green' };
              var occLabel = function (k) { for (var i = 0; i < OCC.length; i++) if (OCC[i][0] === k) return OCC[i][1]; return ''; };
              var uniq = function (list) { return list.filter(function (x, i) { return x && list.indexOf(x) === i; }); };
              var fromTags = function (tags, prefix, map) {
                return uniq(tags.filter(function (t) { return t.indexOf(prefix) === 0; }).map(function (t) { return map[t.slice(prefix.length)]; }));
              };
              var fromField = function (value, map) {
                var whole = map[String(value || '').trim().toLowerCase()];
                if (whole) return [whole];
                return uniq(String(value || '').split(',').map(function (x) { return map[x.trim().toLowerCase()]; }));
              };
              window.pmBsChips = function (root) {
                if (!root) return;
                var facets = window.MGX_SCENT_FACETS || {};
                root.querySelectorAll('[data-pm-bs-row]').forEach(function (row) {
                  var ul = row.querySelector('[data-pm-bs-chips]');
                  if (!ul || ul.hasAttribute('data-built')) return;
                  var f = facets[row.dataset.handle];
                  var occ;
                  var fam;
                  if (f) {
                    occ = f[0] || [];
                    fam = f[1] || [];
                  } else {
                    var tags = String(row.dataset.tags || '').split('|').map(function (t) { return t.trim().toLowerCase(); });
                    occ = fromTags(tags, 'occasion:', TAG_OCC);
                    fam = fromTags(tags, 'scent:', TAG_FAM);
                    if (!occ.length) occ = fromField(row.dataset.occField, FIELD_OCC);
                    if (!fam.length) fam = fromField(row.dataset.famField, FIELD_FAM);
                  }
                  var first = '';
                  for (var i = 0; i < OCC.length && !first; i++) if (occ.indexOf(OCC[i][0]) > -1) first = OCC[i][1];
                  var chips = [first].concat(fam.map(function (k) { return FAM[k]; })).filter(Boolean).slice(0, 2);
                  ul.textContent = '';
                  chips.forEach(function (label) {
                    var li = document.createElement('li');
                    li.className = 'pm-bs-row__tag';
                    li.textContent = label;
                    ul.appendChild(li);
                  });
                  ul.hidden = !chips.length;
                  ul.setAttribute('data-built', '');
                  row.dataset.chipWords = occ.map(occLabel).concat(fam.map(function (k) { return FAM[k]; })).filter(Boolean).join(' ');
                });
              };
            }
            window.pmBsChips(document.getElementById('PmBundleSave-{{ section.id }}'));
          })();
        </script>
        <p class="pm-bs-empty" x-show="visibleRows === 0 && !findActive" x-cloak>{{ st.empty_text | escape }}</p>
        {%- if st.show_filters -%}
          <p class="pm-bs-find__empty" x-show="visibleRows === 0 && findActive" x-cloak>
            {{ st.search_empty_text | escape }}
            <button type="button" class="pm-bs-find__reset" @click="resetFind()">{{ st.search_clear_label | escape }}</button>
          </p>
        {%- endif -%}
        {%- if st.scroll_hint != blank -%}
          <p class="pm-bs-scroll" x-show="!scrollEnd" aria-hidden="true">
            {{ st.scroll_hint | escape }}
            {%- render 'pm-icon', icon: 'chevron-down', size: 12, stroke: 2 -%}
          </p>
        {%- endif -%}
      </div>

      {%- comment -%} 7. CTA {%- endcomment -%}
      <div class="pm-bs-cta">
        <button
          type="button"
          class="pm-btn pm-btn--primary pm-bs-cta__btn"
          disabled
          :disabled="!canAdd"
          :aria-busy="adding ? 'true' : 'false'"
          @click="addToCart()"
          {% if pm_bp != blank %}data-bundle-product-id="{{ pm_bp.id }}"{% endif %}
        >
          <span x-text="ctaText">{{ st.cta_empty | escape }}</span>
        </button>
        <p class="pm-bs-error" role="alert" x-show="error" x-text="error" x-cloak></p>
        {%- if pm_bp == blank and request.design_mode -%}
          <p class="pm-bs-error">Pick the bundle product in the section settings (handle bundle-and-save is used when empty).</p>
        {%- endif -%}
      </div>

      {%- comment -%} 8. Payment icons {%- endcomment -%}
      {%- if st.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul class="pm-bs-pay" aria-label="{{ 'premium.pdp.payment_methods' | t | escape }}">
          {%- for type in shop.enabled_payment_types -%}
            <li class="pm-bs-pay__item">{{ type | payment_type_svg_tag: class: 'pm-bs-pay__icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- comment -%} 8b. Shipping badges: ships from / carriers / guarantee (snippets/mgx-shipping-badges) {%- endcomment -%}
      {%- if st.show_shipping_badges -%}
        {% render 'mgx-shipping-badges',
          product: pm_bp,
          delivery_text: st.badge_delivery_text,
          carrier_text: st.badge_carrier_text,
          guarantee_text: st.badge_guarantee_text
        %}
      {%- endif -%}

      {%- comment -%} 9. Mini review slider {%- endcomment -%}
      {%- assign pm_rev_count = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'mini_review' and block.settings.quote != blank -%}
          {%- assign pm_rev_count = pm_rev_count | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if pm_rev_count > 0 -%}
        <div class="pm-bs-reviews" @mouseenter="revPaused = true" @mouseleave="revPaused = false" @focusin="revPaused = true" @focusout="revPaused = false">
          <div class="pm-bs-reviews__stack">
            {%- assign ri = 0 -%}
            {%- for block in section.blocks -%}
              {%- if block.type != 'mini_review' or block.settings.quote == blank -%}{%- continue -%}{%- endif -%}
              <figure
                class="pm-bs-review{% if ri == 0 %} is-active{% endif %}"
                :class="{ 'is-active': rev === {{ ri }} }"
                :aria-hidden="rev === {{ ri }} ? 'false' : 'true'"
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 160 | image_tag: width: 64, height: 64, loading: 'lazy', alt: block.settings.name, class: 'pm-bs-review__img' }}
                {%- endif -%}
                <div class="pm-bs-review__body">
                  {%- render 'pm-stars', rating: 5, size: 12, class: 'pm-bs-review__stars' -%}
                  <blockquote class="pm-bs-review__quote">{{ block.settings.quote | escape }}</blockquote>
                  <figcaption class="pm-bs-review__by">
                    {%- if block.settings.verified -%}
                      {%- render 'pm-icon', icon: 'check-circle', size: 14, stroke: 1.75 -%}
                    {%- endif -%}
                    <span class="pm-bs-review__name">{{ block.settings.name | escape }}</span>
                    {%- if block.settings.verified -%}
                      <span class="pm-bs-review__verified">{{ st.verified_label | escape }}</span>
                    {%- endif -%}
                  </figcaption>
                </div>
              </figure>
              {%- assign ri = ri | plus: 1 -%}
            {%- endfor -%}
          </div>
          {%- if pm_rev_count > 1 -%}
            <div class="pm-bs-dots">
              {%- for i in (1..pm_rev_count) -%}
                {%- assign di = forloop.index0 -%}
                <button
                  type="button"
                  class="pm-bs-dot{% if di == 0 %} is-active{% endif %}"
                  :class="{ 'is-active': rev === {{ di }} }"
                  @click="rev = {{ di }}"
                  aria-label="{{ forloop.index }} / {{ pm_rev_count }}"
                ></button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- comment -%} 10. Mini FAQ (own class: .pm-bs-faq belongs to the full FAQ section) {%- endcomment -%}
      {%- capture pm_faq -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'mini_faq' and block.settings.question != blank -%}
            <details {{ block.shopify_attributes }}>
              <summary>{{ block.settings.question | escape }}</summary>
              <div class="pm-bs-mfaq__a rte">{{ block.settings.answer }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- if pm_faq != blank -%}
        <div class="pm-bs-mfaq">{{ pm_faq }}</div>
      {%- endif -%}

      {%- comment -%} 11. Guarantee {%- endcomment -%}
      {%- if st.guarantee_heading != blank or st.guarantee_text != blank -%}
        <div class="pm-bs-guarantee">
          {%- if st.guarantee_heading != blank -%}
            <p class="pm-bs-guarantee__title">
              {%- render 'pm-icon', icon: 'shield', size: 20, stroke: 1.5 -%}
              <span>{{ st.guarantee_heading | escape }}</span>
            </p>
          {%- endif -%}
          {%- if st.guarantee_text != blank -%}
            <div class="pm-bs-guarantee__text rte">{{ st.guarantee_text }}</div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<script>
  (function () {
    /* Minimal Shopify money formatter (the theme has no window.pmMoney) */
    function withDelimiters(cents, precision, thousands, decimal) {
      var fixed = (Math.round(Number(cents) || 0) / 100).toFixed(precision);
      var parts = fixed.split('.');
      var whole = parts[0].replace(/(\d)(?=(\d{3})+(?!\d))/g, '$1' + thousands);
      return parts[1] ? whole + decimal + parts[1] : whole;
    }
    function formatMoney(cents, format) {
      /* No literal double braces here: this file is Liquid. Empty format = plain $ amount. */
      if (typeof format !== 'string' || format === '') format = '$';
      var placeholder = /\{\{\s*(\w+)\s*\}\}/;
      var match = format.match(placeholder);
      var type = match ? match[1] : 'amount';
      var value = Math.round(Number(cents) || 0);
      var negative = value < 0;
      if (negative) value = Math.abs(value);
      var out;
      switch (type) {
        case 'amount_no_decimals': out = withDelimiters(value, 0, ',', '.'); break;
        case 'amount_with_comma_separator': out = withDelimiters(value, 2, '.', ','); break;
        case 'amount_no_decimals_with_comma_separator': out = withDelimiters(value, 0, '.', ','); break;
        case 'amount_with_apostrophe_separator': out = withDelimiters(value, 2, "'", '.'); break;
        case 'amount_no_decimals_with_space_separator': out = withDelimiters(value, 0, ' ', '.'); break;
        case 'amount_with_space_separator': out = withDelimiters(value, 2, ' ', ','); break;
        case 'amount_with_period_and_space_separator': out = withDelimiters(value, 2, ' ', '.'); break;
        default: out = withDelimiters(value, 2, ',', '.');
      }
      var result = match ? format.replace(placeholder, out) : out;
      return negative ? '-' + result : result;
    }

    /* Picker search (same rules as assets/collection-search.js and the Whop picker): scent name, number, brand and
       note tags, the "Inspired by" perfume, every occasion and scent family label, house synonyms. */
    var FIND_SKIP_PREFIX = ['season', 'character', 'occasion', 'gender'];
    var FIND_SKIP_TAG = ['men', 'women', 'unisex', 'for men', 'for women', 'fuer maenner', 'fuer frauen', 'dfw active', 'new', 'new arrival', 'bundle', 'bundle price show', 'bundle test', 'giftbox ghost product', 'hide bundle', 'usa test', 'mystery box', 'hidden', 'onsale', '25 edp', 'local image', 'price test', 'bestseller', 'all seasons', 'all season', 'fall', 'winter', 'spring', 'summer'];
    var FIND_SKIP_RE = /^test [a-z] \d+$/;
    var FIND_SYNONYMS = [['jean paul gaultier', 'jpgaultier', 'jp gaultier', 'jpg', 'gaultier'], ['yves saint laurent', 'ysl', 'saint laurent'], ['maison francis kurkdjian', 'mfk', 'kurkdjian'], ['dolce gabbana', 'dolce and gabbana', 'dg', 'd g'], ['louis vuitton', 'lv'], ['thierry mugler', 'mugler'], ['paco rabanne', 'rabanne'], ['giorgio armani', 'emporio armani', 'armani'], ['hugo boss', 'boss'], ['christian dior', 'dior'], ['bvlgari', 'bulgari'], ['calvin klein', 'ck'], ['viktor rolf', 'viktor and rolf', 'viktor'], ['by kilian', 'kilian'], ['escentric molecules', 'molecules'], ['carolina herrera', 'herrera'], ['tom ford', 'tomford'], ['vanilla', 'vanille', 'vainilla', 'vaniglia', 'wanilia']];
    function findFold(value) {
      var text = String(value == null ? '' : value).toLowerCase();
      try { text = text.normalize('NFD').replace(/[̀-ͯ]/g, ''); } catch (e) {}
      return text.replace(/ß/g, 'ss').replace(/æ/g, 'ae').replace(/œ/g, 'oe').replace(/ø/g, 'o').replace(/ł/g, 'l').replace(/['’`]/g, '').replace(/[^a-z0-9]+/g, ' ').trim();
    }
    function findTagWords(raw) {
      return String(raw || '').split('|').map(function (tag) {
        var colon = tag.indexOf(':');
        if (colon > -1) return FIND_SKIP_PREFIX.indexOf(findFold(tag.slice(0, colon))) > -1 ? '' : tag.slice(colon + 1);
        var folded = findFold(tag);
        return FIND_SKIP_TAG.indexOf(folded) > -1 || FIND_SKIP_RE.test(folded) ? '' : tag;
      }).join(' ');
    }
    /* Every number in the title, without and with leading zeros: "No. 034" -> 34, 034 */
    function findNumbers(folded) {
      return (folded.match(/\d+/g) || []).map(function (d) {
        var bare = d.replace(/^0+(?=\d)/, '');
        return bare + ' ' + ('000' + bare).slice(-Math.max(3, bare.length));
      }).join(' ');
    }
    function findEntry(row) {
      var parts = String(row.dataset.search || '').split(' | ');
      var title = parts.shift() || '';
      var hay = ' ' + findFold([title, parts.join(' '), findTagWords(row.dataset.tags), row.dataset.chipWords || ''].join(' ')) + ' ' + findNumbers(findFold(title)) + ' ';
      FIND_SYNONYMS.forEach(function (group) {
        if (group.some(function (phrase) { return hay.indexOf(' ' + phrase + ' ') > -1; })) hay += group.join(' ') + ' ';
      });
      return { hay: hay, compact: hay.replace(/ /g, '') };
    }
    function findParse(raw) {
      var folded = findFold(raw);
      var terms = folded ? folded.split(' ').map(function (t) { return /^\d+$/.test(t) ? t.replace(/^0+(?=\d)/, '') : t; }) : [];
      return { terms: terms, compact: folded.replace(/ /g, '') };
    }
    /* Numbers match a whole word ("21" is not "219"); words up to 3 letters match the start of a word ("di" finds
       "dior" while typing, "man" skips "gourmand"); longer terms match anywhere; words typed together from 4 letters. */
    function findMatch(entry, query) {
      var all = query.terms.every(function (term) {
        if (/^\d+$/.test(term)) return entry.hay.indexOf(' ' + term + ' ') > -1;
        if (term.length <= 3) return entry.hay.indexOf(' ' + term) > -1;
        return entry.hay.indexOf(term) > -1;
      });
      return all || (query.compact.length >= 4 && entry.compact.indexOf(query.compact) > -1);
    }

    /* Kite "Goal Based" progress bar (app embed, the cart drawer's bar): amount goals in the visitor's currency, with
       Kite's own market rule (market value, else the primary market's value, else the base value converted).
       null = Kite not loaded yet, [] = no usable goal. */
    function kiteGoals() {
      var g = window.gfg;
      var list = g && g.settings && g.settings.consolidatedCombinedDiscount;
      if (!Array.isArray(list)) return null;
      var rate = parseFloat(window.Shopify && window.Shopify.currency && window.Shopify.currency.rate) || 1;
      var market = String((g.state && g.state.activeCustomerData && g.state.activeCustomerData.markets && g.state.activeCustomerData.markets.handle) || (window.shopifyLiquidValuesApp7Ext && window.shopifyLiquidValuesApp7Ext.markets && window.shopifyLiquidValuesApp7Ext.markets.handle) || '');
      var pick = function (values, test) {
        for (var i = 0; i < values.length; i++) {
          var m = values[i];
          var n = parseFloat(m && m.value);
          if (test(m) && n && isFinite(n)) return m.multiCurrency === true ? n * rate : n;
        }
        return null;
      };
      var resolve = function (rv) {
        var base = parseFloat(rv.qualifierValue || 0) || 0;
        var values = Array.isArray(rv.marketValues) ? rv.marketValues : [];
        if (!values.length) return base * rate;
        var own = pick(values, function (m) { return m && m.handle === market; });
        if (own != null) return own;
        var primary = pick(values, function (m) { return m && m.primary === true; });
        return primary != null ? primary : base * rate;
      };
      var camp = null;
      for (var c = 0; c < list.length; c++) {
        var x = list[c];
        if (x && x.isEnabled !== false && !x.isDeleted && x.discountFunctionType === 'CONSOLIDATED_PROGRESS_BAR') { camp = x; break; }
      }
      if (!camp) return [];
      /* Goals that only apply to some customers or markets: leave the bar out rather than promise them */
      var elig = camp.customerEligibilityRules && camp.customerEligibilityRules.rulesList;
      if (elig && elig.length) return [];
      try {
        if (g.utility && g.utility.getCampaignScheduleStatus && g.utility.getCampaignScheduleStatus(camp.campaignScheduleData).expired) return [];
      } catch (e) {}
      var out = [];
      ((camp.segmentsData && camp.segmentsData.segmentsList) || []).forEach(function (seg) {
        var rule = seg && seg.buyXRulesData && seg.buyXRulesData.rulesList && seg.buyXRulesData.rulesList[0];
        if (!rule || (rule.ruleType !== 'discountedCartSubtotal' && rule.ruleType !== 'cartSubtotal')) return;
        var rv = rule.ruleValue || {};
        if (rv.qualifierOperatorType && rv.qualifierOperatorType !== 'greaterThanOrEqualTo') return;
        var getY = (seg.getYRulesData && seg.getYRulesData.rulesList) || [];
        var kind = seg.goalType === 'FREE_GIFT' ? 'gift' : getY.some(function (r) { return r && r.type === 'SHIPPING'; }) ? 'shipping' : '';
        var amount = resolve(rv);
        if (!kind || !(amount > 0)) return;
        out.push({ kind: kind, threshold: Math.round(amount * 100), metric: rule.ruleType });
      });
      return out.sort(function (a, b) { return a.threshold - b.threshold; });
    }

    function escapeHtml(s) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; });
    }

    function register() {
      if (window.__pmBundleSaveRegistered) return;
      window.__pmBundleSaveRegistered = true;
      window.Alpine.data('pmBundleSave', function () {
        /* Per-row search entries and gender sets, kept out of the reactive state */
        var rowMeta = {};
        return {
          cfg: null,
          tierIndex: 0,
          lineIndex: -1,
          picks: [],
          names: {},
          rowLines: {},
          rowIds: [],
          sex: '',
          findText: '',
          findQuery: { terms: [], compact: '' },
          rwGoals: null,
          rwCart: null,
          adding: false,
          error: '',
          scrollEnd: false,
          media: 0,
          rev: 0,
          revCount: 0,
          revPaused: false,
          clock: { h: '00', m: '00', s: '00' },

          init: function () {
            var self = this;
            var node = this.$el.querySelector('[data-pm-bs-config]');
            try {
              this.cfg = JSON.parse(node ? node.textContent : '{}');
            } catch (e) {
              this.cfg = {};
            }
            this.cfg.tiers = this.cfg.tiers || [];
            this.cfg.lines = this.cfg.lines || [];
            this.cfg.variants = this.cfg.variants || {};
            this.cfg.text = this.cfg.text || {};
            this.tierIndex = Math.min(Math.max(this.cfg.tierStart || 0, 0), Math.max(this.cfg.tiers.length - 1, 0));
            this.lineIndex = typeof this.cfg.lineStart === 'number' && this.cfg.lineStart < this.cfg.lines.length ? this.cfg.lineStart : -1;

            if (window.pmBsChips) window.pmBsChips(this.$el);
            var ids = [];
            this.$el.querySelectorAll('[data-pm-bs-row]').forEach(function (row) {
              var vid = row.dataset.vid;
              self.names[vid] = row.dataset.title;
              self.rowLines[vid] = row.dataset.line || '';
              rowMeta[vid] = { sex: String(row.dataset.sex || '').split(' ').filter(Boolean), entry: findEntry(row) };
              ids.push(vid);
            });
            this.rowIds = ids;
            this.revCount = this.$el.querySelectorAll('.pm-bs-review').length;

            if (this.cfg.timerOn) this.startTimer();
            if (this.revCount > 1) this.startReviews();
            var toTop = function () {
              if (self.$refs.list) self.$refs.list.scrollTop = 0;
              self.$nextTick(function () { self.checkScroll(); });
            };
            this.$watch('lineIndex', toTop);
            this.$watch('sex', toTop);
            this.$watch('findQuery', toTop);
            this.$nextTick(function () { self.checkScroll(); });
            /* Back/forward cache or browser autofill can leave text in the search box */
            this.$nextTick(function () { if (self.$refs.find && self.$refs.find.value) self.setFind(self.$refs.find.value); });
            if (this.cfg.rewardsOn) this.startRewards();
          },

          /* Tiers */
          get tier() { return this.cfg.tiers[this.tierIndex] || { bottles: 1, cap: 1 }; },
          get target() { return this.tier.bottles; },
          get cap() { return this.tier.cap; },
          get maxTotal() { return this.cfg.maxTotal || 0; },
          get atMax() { return this.picks.length >= this.maxTotal; },
          liveTier: function (i) {
            if (this.tierIndex !== i) return null;
            var t = this.cfg.tiers[i];
            var n = this.picks.length;
            if (!t || n <= t.bottles || n > t.cap) return null;
            return this.cfg.variants[String(n)] || null;
          },
          selectTier: function (i) {
            this.tierIndex = i;
            if (this.picks.length > this.cap) this.picks = this.picks.slice(0, this.cap);
            this.error = '';
          },
          bumpTier: function () {
            var count = this.picks.length;
            if (count <= this.cap) return;
            var best = -1;
            this.cfg.tiers.forEach(function (t, i) {
              if (t.cap < count) return;
              if (best === -1) { best = i; return; }
              var b = this.cfg.tiers[best];
              if (t.cap < b.cap || (t.cap === b.cap && t.bottles < b.bottles)) best = i;
            }, this);
            if (best !== -1) this.tierIndex = best;
          },

          /* Lines (optional: with zero line blocks lineIndex stays -1 and every scent shows) */
          toggleLine: function (i) { this.lineIndex = this.lineIndex === i ? -1 : i; },
          lineOk: function (line) {
            if (this.lineIndex < 0) return true;
            var l = this.cfg.lines[this.lineIndex];
            return !l || (l.tag || '') === line;
          },
          lineCount: function (i) {
            var l = this.cfg.lines[i];
            if (!l) return 0;
            var tag = l.tag || '';
            return this.picks.filter(function (vid) { return this.rowLines[vid] === tag; }, this).length;
          },
          linePickedText: function (i) {
            return String(this.cfg.text.linePicked || '[n]').replace('[n]', this.lineCount(i));
          },
          /* A row shows when it passes the line card, the gender pill and the search (hidden rows keep their picks) */
          rowOk: function (vid) {
            if (!this.lineOk(this.rowLines[vid] || '')) return false;
            var meta = rowMeta[vid];
            if (this.sex && !(meta && meta.sex.indexOf(this.sex) > -1)) return false;
            if (this.findQuery.terms.length && !(meta && findMatch(meta.entry, this.findQuery))) return false;
            return true;
          },
          get visibleRows() {
            var n = 0;
            for (var i = 0; i < this.rowIds.length; i++) if (this.rowOk(this.rowIds[i])) n++;
            return n;
          },

          /* Search + gender pills */
          get findActive() { return this.findQuery.terms.length > 0 || this.sex !== ''; },
          onFindInput: function (value) {
            var self = this;
            this.findText = value;
            clearTimeout(this._findTimer);
            this._findTimer = setTimeout(function () { self.setFind(value); }, 120);
          },
          setFind: function (value) {
            clearTimeout(this._findTimer);
            var input = this.$refs.find;
            if (input && input.value !== value) input.value = value;
            this.findText = value;
            this.findQuery = findParse(value);
          },
          onFindEscape: function (e) {
            if (!e.target.value) return;
            e.preventDefault();
            e.stopPropagation();
            this.setFind('');
          },
          onFindEnter: function (e) {
            this.setFind(e.target.value);
            e.target.blur();
          },
          resetFind: function () {
            this.sex = '';
            this.setFind('');
            if (this.$refs.find) this.$refs.find.focus();
          },

          /* Cart rewards bar: Kite goals + the cart (/cart.js) + the bundle being built until these picks are in the cart */
          startRewards: function () {
            var self = this;
            var tries = 0;
            var poll = function () {
              var goals = kiteGoals();
              if (goals) {
                self.rwGoals = goals;
                return;
              }
              if (++tries < 60) self._rwPoll = setTimeout(poll, 250);
            };
            poll();
            this.loadCart();
            if (typeof subscribe === 'function' && typeof PUB_SUB_EVENTS !== 'undefined' && !this._rwUnsub) {
              this._rwUnsub = subscribe(PUB_SUB_EVENTS.cartUpdate, function () { self.loadCart(); });
            }
          },
          loadCart: function () {
            var self = this;
            var root = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
            var v = (this._rwVersion = (this._rwVersion || 0) + 1);
            fetch(root + 'cart.js', { headers: { Accept: 'application/json' } })
              .then(function (res) { return res.ok ? res.json() : null; })
              .then(function (cart) {
                if (!cart || v !== self._rwVersion) return;
                var lines = (cart.items || []).filter(function (l) { return !(l.properties && l.properties._free_product); });
                var sum = function (key) { return lines.reduce(function (s, l) { return s + (Number(l[key]) || 0); }, 0); };
                var cartOff = (cart.cart_level_discount_applications || []).reduce(function (s, d) { return s + (Number(d.total_allocated_amount) || 0); }, 0);
                self.rwCart = {
                  discountedCartSubtotal: sum('final_line_price') - cartOff,
                  cartSubtotal: sum('original_line_price'),
                  bundles: lines.map(function (l) { return String((l.properties && l.properties._bundle_items) || ''); })
                };
              })
              .catch(function () {});
          },
          get rewards() {
            var goals = this.rwGoals;
            var cart = this.rwCart;
            var text = (this.cfg && this.cfg.text) || {};
            if (!this.cfg || !this.cfg.rewardsOn || !goals || !goals.length || !cart) return null;
            var extra = 0;
            var n = this.picks.length;
            if (n > 0 && this.cfg.mode !== 'per_line' && cart.bundles.indexOf(this.picks.join(',')) === -1) {
              var bv = this.bundleVariant || this.cfg.variants[String(this.target)];
              if (bv) extra = Number(bv.price) || 0;
            }
            var paid = (cart[goals[0].metric] || 0) + extra;
            var count = goals.length;
            var pos = function (i) { return ((2 * i + 1) / (2 * count)) * 100; };
            var pct = 100;
            for (var i = 0; i < count; i++) {
              if (paid < goals[i].threshold) {
                var pt = i ? goals[i - 1].threshold : 0;
                var pp = i ? pos(i - 1) : 0;
                pct = pp + ((pos(i) - pp) * Math.max(0, paid - pt)) / Math.max(1, goals[i].threshold - pt);
                break;
              }
            }
            var self = this;
            var next = null;
            var gifts = false;
            var steps = goals.map(function (g) {
              var on = paid >= g.threshold;
              if (!on && !next) next = g;
              if (g.kind === 'gift') gifts = true;
              return { kind: g.kind, on: on, amount: self.money(g.threshold), label: g.kind === 'shipping' ? text.rwShippingLabel : text.rwGiftLabel };
            });
            var msg;
            if (next) {
              var away = '<b>' + escapeHtml(this.money(next.threshold - paid)) + '</b>';
              msg = escapeHtml(next.kind === 'shipping' ? text.rwShippingAway : text.rwGiftAway).replace('[amount]', away);
            } else {
              msg = escapeHtml(extra > 0 && gifts ? text.rwDonePreview : gifts ? text.rwDone : text.rwDoneShipping);
            }
            return { msg: msg, done: !next, pct: Math.round(pct * 10) / 10, steps: steps };
          },

          /* Picks */
          qty: function (vid) {
            var key = String(vid);
            return this.picks.filter(function (p) { return p === key; }).length;
          },
          add: function (vid) {
            if (this.atMax) return;
            this.picks.push(String(vid));
            this.bumpTier();
            this.error = '';
          },
          remove: function (vid) {
            var i = this.picks.lastIndexOf(String(vid));
            if (i > -1) this.picks.splice(i, 1);
            this.error = '';
          },
          get shownTotal() { return Math.max(this.target, this.picks.length); },
          get percent() {
            return this.shownTotal ? Math.min(100, Math.round((this.picks.length / this.shownTotal) * 100)) : 0;
          },
          get scentsHeading() { return String(this.cfg.text.scentsHeading || '').replace('[n]', this.shownTotal); },
          get counterText() {
            return String(this.cfg.text.counter || '').replace('[x]', this.picks.length).replace('[n]', this.shownTotal);
          },
          get hintText() {
            var n = this.picks.length;
            if (n > 0 && n >= this.maxTotal) return String(this.cfg.text.max || '').replace('[max]', this.maxTotal);
            if (n > 0 && n < this.target) return String(this.cfg.text.remaining || '').replace('[remaining]', this.target - n);
            return '';
          },

          /* Price + CTA */
          get bundleVariant() { return this.cfg.variants[String(this.picks.length)] || null; },
          get canAdd() {
            if (this.adding || this.picks.length === 0) return false;
            if (this.cfg.mode === 'per_line') return true;
            return !!(this.bundleVariant && this.bundleVariant.available);
          },
          get ctaText() {
            if (this.adding) return this.cfg.text.adding || '';
            if (this.picks.length === 0) return this.cfg.text.ctaEmpty || '';
            var v = this.bundleVariant;
            if (this.cfg.mode !== 'per_line' && v) return this.cfg.text.cta + ' · ' + this.money(v.price);
            return this.cfg.text.cta || '';
          },
          money: function (cents) {
            return formatMoney(cents, this.cfg && this.cfg.moneyFormat).replace(/[.,]00(?=\D*$)/, '');
          },
          addToCart: function () {
            if (!this.canAdd) return;
            var self = this;
            var items;
            if (this.cfg.mode === 'per_line') {
              var counts = {};
              var order = [];
              this.picks.forEach(function (vid) {
                if (!counts[vid]) { counts[vid] = 0; order.push(vid); }
                counts[vid] += 1;
              });
              items = order.map(function (vid) { return { id: Number(vid), quantity: counts[vid] }; });
            } else {
              var props = {};
              var label = this.cfg.text.bottle || 'Bottle';
              this.picks.forEach(function (vid, i) { props[label + ' ' + (i + 1)] = self.names[vid] || vid; });
              props._bundle_items = this.picks.join(',');
              items = [{ id: this.bundleVariant.id, quantity: 1, properties: props }];
            }

            var cart = document.querySelector('cart-drawer');
            var body = { items: items };
            if (cart && typeof cart.getSectionsToRender === 'function') {
              body.sections = cart.getSectionsToRender().map(function (s) { return s.id; });
              body.sections_url = window.location.pathname;
              if (typeof cart.setActiveElement === 'function') cart.setActiveElement(document.activeElement);
            }
            var root = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';

            this.adding = true;
            this.error = '';
            fetch(root + 'cart/add.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', Accept: 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
              body: JSON.stringify(body)
            })
              .then(function (res) {
                return res.json().catch(function () { return {}; }).then(function (data) {
                  if (!res.ok || data.status) {
                    var err = new Error(data.description || data.message || 'cart');
                    err.data = data;
                    throw err;
                  }
                  return data;
                });
              })
              .then(function (data) {
                if (cart && typeof cart.renderContents === 'function' && data.sections) {
                  if (typeof publish === 'function' && typeof PUB_SUB_EVENTS !== 'undefined') {
                    publish(PUB_SUB_EVENTS.cartUpdate, { source: 'pm-bundle-save', cartData: data });
                  }
                  cart.renderContents(data);
                  if (cart.classList.contains('is-empty')) cart.classList.remove('is-empty');
                } else {
                  window.location.href = (window.routes && window.routes.cart_url) || '/cart';
                }
              })
              .catch(function (err) {
                var d = (err && err.data) || {};
                self.error = d.description || d.message || self.cfg.text.error || '';
              })
              .finally(function () { self.adding = false; });
          },

          /* Gallery */
          onTrack: function () {
            var t = this.$refs.track;
            if (!t || !t.clientWidth) return;
            this.media = Math.round(t.scrollLeft / t.clientWidth);
          },
          goTo: function (i) {
            var t = this.$refs.track;
            if (!t) return;
            var n = t.children.length;
            var idx = Math.max(0, Math.min(n - 1, i));
            this.media = idx;
            t.scrollTo({ left: idx * t.clientWidth, behavior: 'smooth' });
          },

          /* Scroll hint */
          checkScroll: function () {
            var l = this.$refs.list;
            if (!l) return;
            this.scrollEnd = l.scrollTop + l.clientHeight >= l.scrollHeight - 8 || this.visibleRows === 0;
          },

          /* Countdown: evergreen per visitor, start stored in localStorage, restarts after each period */
          startTimer: function () {
            var self = this;
            var period = (Number(this.cfg.timerHours) || 24) * 3600000;
            var key = 'pmBundleSaveTimerStart';
            var start = Date.now();
            try {
              var saved = Number(window.localStorage.getItem(key));
              if (saved && saved <= start) {
                start = saved;
              } else {
                window.localStorage.setItem(key, String(start));
              }
            } catch (e) {}
            var pad = function (n) { return (n < 10 ? '0' : '') + n; };
            var tick = function () {
              var left = period - ((Date.now() - start) % period);
              var s = Math.floor(left / 1000);
              self.clock = { h: pad(Math.floor(s / 3600)), m: pad(Math.floor((s % 3600) / 60)), s: pad(s % 60) };
            };
            tick();
            clearInterval(this._timerId);
            this._timerId = setInterval(tick, 1000);
          },

          /* Alpine calls this when the theme editor re-renders the section */
          destroy: function () {
            clearInterval(this._timerId);
            clearInterval(this._revId);
            clearTimeout(this._rwPoll);
            clearTimeout(this._findTimer);
            if (typeof this._rwUnsub === 'function') this._rwUnsub();
          },

          /* Reviews */
          startReviews: function () {
            var self = this;
            var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            if (reduce) return;
            clearInterval(this._revId);
            this._revId = setInterval(function () {
              if (self.revPaused || document.hidden) return;
              self.rev = (self.rev + 1) % self.revCount;
            }, this.cfg.reviewMs || 5000);
          }
        };
      });
    }

    if (window.Alpine) {
      register();
    } else {
      document.addEventListener('alpine:init', register);
    }

    /* Theme editor: a freshly added or re-rendered section can reach Alpine before the
       component is registered, so re-init its tree once the section has loaded */
    if (!window.pmBundleSaveEditorHook) {
      window.pmBundleSaveEditorHook = true;
      document.addEventListener('shopify:section:load', function (e) {
        var el = e.target && e.target.querySelector('[x-data="pmBundleSave"]');
        if (!el || !window.Alpine) return;
        register();
        if (window.Alpine.destroyTree) window.Alpine.destroyTree(el);
        window.Alpine.initTree(el);
      });
    }

    /* Alpine is not global on this theme: load it once if no other section on the page brought it */
    function ensureAlpine() {
      if (window.Alpine || document.querySelector('script[data-pm-alpine]')) return;
      var s = document.createElement('script');
      s.src = 'https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js';
      s.defer = true;
      s.setAttribute('data-pm-alpine', '');
      document.head.appendChild(s);
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', ensureAlpine);
    } else {
      ensureAlpine();
    }
  })();
</script>

