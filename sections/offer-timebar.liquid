<link rel="stylesheet" href="https://pbutcher.uk/flipdown/css/flipdown/flipdown.css">
<script defer src="https://pbutcher.uk/flipdown/js/flipdown/flipdown.js"></script>

<style>
  .flipdown {
    width: 190px;
    height: 42px;
  }

  .flipdown div:empty {
    display: block;
  }

  .flipdown .rotor {
    font-size: 1.32rem;
    margin-right: 1.8px;
  }

  .flipdown .rotor,
  .flipdown .rotor-leaf,
  .flipdown .rotor-leaf-front,
  .flipdown .rotor-leaf-rear,
  .flipdown .rotor-top,
  .flipdown .rotor-bottom,
  .flipdown .rotor:after {
    width: 18px;
  }

  .flipdown .rotor-group {
    padding-right: 12px;
  }

  .flipdown .rotor-group:last-child {
    padding-right: 0;
  }

  .flipdown .rotor-group-heading:before {
    font-size: 0.48rem;
    height: 12px;
    line-height: 12px;
  }

  .flipdown .rotor-group:nth-child(n + 2):nth-child(-n + 3):before,
  .flipdown .rotor-group:nth-child(n + 2):nth-child(-n + 3):after {
    left: 41px;
  }

  .flipdown .rotor-group:nth-child(n + 2):nth-child(-n + 3):before {
    bottom: 7.8px;
    height: 4.8px;
    width: 4.8px;
  }

  .flipdown .rotor-group:nth-child(n + 2):nth-child(-n + 3):after {
    bottom: 17.4px;
    height: 4.8px;
    width: 4.8px;
  }

  .flipdown .rotor-leaf-front,
  .flipdown .rotor-top {
    line-height: 30px;
  }

  .flipdown .rotor-leaf,
  .flipdown .rotor {
    height: 30px;
  }

  .flipdown .rotor-leaf-front,
  .flipdown .rotor-leaf-rear,
  .flipdown .rotor-top,
  .flipdown .rotor-bottom,
  .flipdown .rotor:after {
    height: 15px;
  }

  .flipdown.flipdown__theme-dark .rotor-group-heading:before {
    color: {{ section.settings.timer_label_color }};
    font-size: 8px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .timebar-section-bg {
    display: block;
    text-decoration: none;
    padding-top: 8px;
    padding-bottom: 8px;
    background-color: #f87171;
    background-repeat: repeat;
  }

  .timebar-container {
    max-width: 1280px;
    margin-left: auto;
    margin-right: auto;
    padding-left: 16px;
    padding-right: 16px;
  }

  .timebar-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .timebar-sale-text {
    color: white;
    font-size: 2rem;
    line-height: 1;
  }

  @media (min-width: 768px) {
    .timebar-row {
      gap: 16px;
    }
  }

  .flipdown.flipdown__theme-dark .rotor-bottom,
  .flipdown.flipdown__theme-dark .rotor-leaf-rear,
  .flipdown.flipdown__theme-dark .rotor,
  .flipdown.flipdown__theme-dark .rotor-top,
  .flipdown.flipdown__theme-dark .rotor-leaf-front {
    background-color: {{ section.settings.timer_box_color }};
  }

  .flipdown.flipdown__theme-dark .rotor-group:nth-child(n + 2):nth-child(-n + 3):before,
  .flipdown.flipdown__theme-dark .rotor-group:nth-child(n + 2):nth-child(-n + 3):after {
    background-color: {{ section.settings.primary_color }};
  }

  .flipdown.flipdown__theme-dark .rotor:after {
    border-color: {{ section.settings.timer_box_color }};
  }

  {% if section.settings.countdown_date == blank %}
    .flipdown {
      width: 140px !important;
    }
    .flipdown .rotor-group:first-child {
      display: none;
    }
  {% endif %}
</style>

{% unless product.template_suffix == 'payday-60' or collection.template_suffix == 'bundle-save' %}

  <div id="{{ section.id }}">
    <a href="{{ section.settings.link }}" class="no-underline block">

      {% if section.settings.enable_top_bar and section.settings.top_banner_text != blank %}
        <div class="py-3" style="background-color: {{ section.settings.primary_color }};">
          <div class="page-width">
            <div class="text-center flex items-center justify-center gap-4 leading-none" style="color: {{ section.settings.secondary_color }};">
              -
              <span>{{ section.settings.top_banner_text }}</span>
              -
            </div>
          </div>
        </div>
      {% endif %}

      <div class="py-3 md:py-2" style="background-color: {{ section.settings.secondary_color }};">
        <div class="container mx-auto px-4">

          <div class="flex flex-wrap items-center gap-x-6 gap-y-1 justify-center">

            <div class="flex flex-wrap gap-x-4 gap-y-1 items-center justify-center">

              <div style="color: {{ section.settings.primary_color }};" class="text-center font-bold text-base md:text-xl">
                {{ section.settings.prepend_text }}
              </div>

              <div style="color: {{ section.settings.primary_color }};" class="text-center font-semibold text-sm md:text-lg tracking-wider md:order-1 underline">
                {{ section.settings.append_text }}
              </div>

              {% if section.settings.enable_timer %}
                <div class="flex items-center gap-2">

                  <div style="color: {{ section.settings.primary_color }};" class="text-sm md:text-base font-bold leading-none md:hidden">
                    Ends in
                  </div>

                  <div id="flipdown" class="flipdown"></div>

                </div>
              {% endif %}

            </div>

            {% if section.settings.enable_badges %}
              {% if section.blocks.size > 0 %}

                <div class="[display:none] md:flex gap-4">

                  {% for block in section.blocks %}

                    <div class="flex flex-col items-center {% unless forloop.last %}pr-4 border-0 border-r border-solid{% endunless %}" style="border-color: {{ section.settings.primary_color | color_modify: 'alpha', 0.25 }};" {{ block.shopify_attributes }}>

                      {% if block.settings.icon != blank %}
                        <img
                          class="rounded"
                          src="{{ block.settings.icon | image_url }}"
                          height="25"
                          width=""
                          alt="{{ block.settings.label }}">
                      {% endif %}

                      {% if block.settings.label != blank %}
                        <div class="leading-none text-xs mt-1 font-semibold" style="color: {{ section.settings.primary_color }};">
                          {{ block.settings.label }}
                        </div>
                      {% endif %}

                    </div>

                  {% endfor %}

                </div>

              {% endif %}
            {% endif %}

          </div>

        </div>
      </div>

    </a>
  </div>

{% endunless %}


{% if section.settings.enable_badges %}
  {% if section.blocks.size > 0 %}

    <div class="md:hidden py-3 border-0 border-t border-solid" style="background-color: {{ section.settings.secondary_color }}; border-color: {{ section.settings.primary_color | color_modify: 'alpha', 0.15 }};">

      <div class="page-width">

        <div class="flex gap-2 justify-between">

          {% for block in section.blocks %}

            <div class="flex flex-col items-center" {{ block.shopify_attributes }}>

              {% if block.settings.icon != blank %}
                <img
                  class="rounded"
                  src="{{ block.settings.icon | image_url }}"
                  height="25"
                  width=""
                  alt="{{ block.settings.label }}">
              {% endif %}

              {% if block.settings.label != blank %}
                <div class="leading-none text-xs mt-1 font-semibold" style="color: {{ section.settings.primary_color }};">
                  {{ block.settings.label }}
                </div>
              {% endif %}

            </div>

            {% unless forloop.last %}
              <div class="!block w-[1px] self-stretch" style="background-color: {{ section.settings.primary_color | color_modify: 'alpha', 0.25 }};"></div>
            {% endunless %}

          {% endfor %}

        </div>

      </div>

    </div>

  {% endif %}
{% endif %}


{% if section.settings.enable_timer %}

  <script>
    document.addEventListener('DOMContentLoaded', () => {

      function getNextMidnightTimestamp() {
        const nextMidnight = new Date();

        nextMidnight.setHours(24, 0, 0, 0);

        return Math.floor(nextMidnight.getTime() / 1000);
      }

      function getCountdownDeadline() {
        const configuredDate = {{ section.settings.countdown_date | json }};

        if (!configuredDate) {
          return getNextMidnightTimestamp();
        }

        const configuredTimestamp =
          Math.floor(new Date(configuredDate).getTime() / 1000);

        return Number.isNaN(configuredTimestamp)
          ? getNextMidnightTimestamp()
          : configuredTimestamp;
      }

      function initializeFlipdown() {
        const flipdownElement = document.getElementById('flipdown');

        if (!flipdownElement) {
          return;
        }

        if (typeof FlipDown === 'undefined') {
          setTimeout(initializeFlipdown, 100);
          return;
        }

        const deadline = getCountdownDeadline();

        new FlipDown(deadline, {
          headings: ["Days", "Hours", "Min", "Sec"]
        })
          .start()
          .ifEnded(() => {
            console.log('Countdown ended');
          });
      }

      initializeFlipdown();

    });
  </script>

{% endif %}


{% schema %}
  {
    "name": "Offer Timebar",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_top_bar",
        "label": "Enable Top Bar",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_timer",
        "label": "Enable Countdown Timer",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_badges",
        "label": "Enable Badges",
        "default": true
      },
      {
        "type": "color",
        "id": "primary_color",
        "label": "Primary Color",
        "default": "#100F0D"
      },
      {
        "type": "color",
        "id": "secondary_color",
        "label": "Secondary Color",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "timer_box_color",
        "label": "Timer box color",
        "default": "#3A3A3C"
      },
      {
        "type": "color",
        "id": "timer_label_color",
        "label": "Timer label color",
        "default": "#C7C9CB"
      },
      {
        "type": "text",
        "id": "top_banner_text",
        "label": "Top Banner Text",
        "info": "Leaving this field empty will also disable the top banner."
      },
      {
        "type": "text",
        "id": "prepend_text",
        "label": "Prepend Text",
        "default": "Exclusive Offer"
      },
      {
        "type": "text",
        "id": "countdown_date",
        "label": "End Date and Time",
        "info": "Format: YYYY/MM/DD HH:MM:SS (e.g., 2026/12/25 23:59:59)"
      },
      {
        "type": "text",
        "id": "append_text",
        "label": "Append Text",
        "default": "Shop Now 👉"
      },
      {
        "type": "url",
        "id": "link",
        "label": "Link"
      }
    ],
    "blocks": [
      {
        "type": "payment_icon",
        "name": "Badge",
        "settings": [
          {
            "type": "image_picker",
            "id": "icon",
            "label": "Icon"
          },
          {
            "type": "text",
            "id": "label",
            "label": "Label"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Offer Timebar"
      }
    ]
  }
{% endschema %}