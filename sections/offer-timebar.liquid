{%- comment -%}
  Top bar in two halves: the offer on Primary colour, the countdown on Timer background.
  Phones stack them (offer above, timer below); from 768px they share one row with a slanted join.
  The countdown is plain JS (no flip library): HH:MM:SS to midnight, or to "Countdown date" with days.
{%- endcomment -%}
{%- liquid
  assign tb_offer_bg = section.settings.primary_color
  assign tb_text = section.settings.secondary_color
  assign tb_timer_bg = section.settings.timer_box_color
  assign tb_label = section.settings.timer_label_color
-%}
<style>
  #shopify-section-{{ section.id }} .mgx-tb {
    display: flex;
    flex-direction: column;
    background-color: {{ tb_timer_bg }};
    color: {{ tb_text }};
    text-decoration: none;
    font-family: 'Figtree', sans-serif;
  }
  #shopify-section-{{ section.id }} .mgx-tb__offer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 4px 12px;
    padding: 9px 16px;
    background-color: {{ tb_offer_bg }};
    text-align: center;
  }
  #shopify-section-{{ section.id }} .mgx-tb__eyebrow {
    font-size: 11px;
    line-height: 16px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0.85;
  }
  #shopify-section-{{ section.id }} .mgx-tb__rule {
    display: block;
    width: 1px;
    height: 14px;
    background-color: {{ tb_text | color_modify: 'alpha', 0.35 }};
  }
  #shopify-section-{{ section.id }} .mgx-tb__deal {
    font-size: 14px;
    line-height: 20px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .mgx-tb__lead {
    font-size: 14px;
    line-height: 20px;
    font-weight: 600;
  }
  #shopify-section-{{ section.id }} .mgx-tb__timer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 7px 16px 8px;
  }
  #shopify-section-{{ section.id }} .mgx-tb__ends {
    font-size: 10px;
    line-height: 14px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: {{ tb_label | color_modify: 'alpha', 0.7 }};
  }
  #shopify-section-{{ section.id }} .mgx-tb__clock {
    display: flex;
    align-items: flex-start;
    gap: 4px;
  }
  #shopify-section-{{ section.id }} .mgx-tb__unit {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  #shopify-section-{{ section.id }} .mgx-tb__num {
    display: block;
    min-width: 30px;
    padding: 3px 4px;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 6px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.12) 0%, rgba(255, 255, 255, 0.03) 100%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08), 0 2px 6px rgba(0, 0, 0, 0.35);
    color: #ffffff;
    font-size: 16px;
    line-height: 20px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .mgx-tb__cap {
    margin-top: 3px;
    font-size: 8px;
    line-height: 10px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: {{ tb_label | color_modify: 'alpha', 0.55 }};
  }
  #shopify-section-{{ section.id }} .mgx-tb__sep {
    font-style: normal;
    font-size: 16px;
    line-height: 28px;
    font-weight: 800;
    color: {{ tb_offer_bg | color_lighten: 12 }};
  }
  #shopify-section-{{ section.id }} .mgx-tb__badges {
    display: none;
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .mgx-tb {
      flex-direction: row;
      align-items: stretch;
    }
    #shopify-section-{{ section.id }} .mgx-tb__offer {
      flex: 1 1 50%;
      justify-content: flex-end;
      padding: 10px 44px 10px 24px;
      clip-path: polygon(0 0, 100% 0, calc(100% - 22px) 100%, 0 100%);
    }
    #shopify-section-{{ section.id }} .mgx-tb__eyebrow {
      font-size: 12px;
    }
    #shopify-section-{{ section.id }} .mgx-tb__deal,
    #shopify-section-{{ section.id }} .mgx-tb__lead {
      font-size: 16px;
      line-height: 22px;
    }
    #shopify-section-{{ section.id }} .mgx-tb__timer {
      flex: 1 1 50%;
      justify-content: flex-start;
      padding: 8px 24px 8px 22px;
    }
    #shopify-section-{{ section.id }} .mgx-tb__ends {
      font-size: 11px;
    }
    #shopify-section-{{ section.id }} .mgx-tb__num {
      min-width: 34px;
      font-size: 18px;
      line-height: 22px;
    }
    #shopify-section-{{ section.id }} .mgx-tb__sep {
      font-size: 18px;
      line-height: 30px;
    }
    #shopify-section-{{ section.id }} .mgx-tb__badges {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-left: 16px;
      padding-left: 16px;
      border-left: 1px solid rgba(255, 255, 255, 0.15);
    }
  }
</style>

{% unless product.template_suffix == 'payday-60' or collection.template_suffix == 'bundle-save' %}

  <div id="{{ section.id }}">
    <a href="{{ section.settings.link }}" class="mgx-tb">

      <div class="mgx-tb__offer">
        {%- if section.settings.enable_top_bar and section.settings.top_banner_text != blank -%}
          <span class="mgx-tb__eyebrow">{{ section.settings.top_banner_text }}</span>
          {%- if section.settings.prepend_text != blank or section.settings.append_text != blank -%}
            <span class="mgx-tb__rule" aria-hidden="true"></span>
          {%- endif -%}
        {%- endif -%}
        {%- if section.settings.prepend_text != blank -%}
          <span class="mgx-tb__lead">{{ section.settings.prepend_text }}</span>
        {%- endif -%}
        {%- if section.settings.append_text != blank -%}
          <span class="mgx-tb__deal">{{ section.settings.append_text }}</span>
        {%- endif -%}
      </div>

      {%- if section.settings.enable_timer -%}
        <div class="mgx-tb__timer">
          <span class="mgx-tb__ends">Ends in</span>
          <span class="mgx-tb__clock" data-mgx-countdown data-deadline="{{ section.settings.countdown_date | escape }}" role="timer" aria-live="off">
            {%- if section.settings.countdown_date != blank -%}
              <span class="mgx-tb__unit"><span class="mgx-tb__num" data-unit="d">00</span><span class="mgx-tb__cap">Days</span></span>
              <i class="mgx-tb__sep" aria-hidden="true">:</i>
            {%- endif -%}
            <span class="mgx-tb__unit"><span class="mgx-tb__num" data-unit="h">00</span><span class="mgx-tb__cap">Hrs</span></span>
            <i class="mgx-tb__sep" aria-hidden="true">:</i>
            <span class="mgx-tb__unit"><span class="mgx-tb__num" data-unit="m">00</span><span class="mgx-tb__cap">Min</span></span>
            <i class="mgx-tb__sep" aria-hidden="true">:</i>
            <span class="mgx-tb__unit"><span class="mgx-tb__num" data-unit="s">00</span><span class="mgx-tb__cap">Sec</span></span>
          </span>

          {%- if section.settings.enable_badges and section.blocks.size > 0 -%}
            <span class="mgx-tb__badges">
              {%- for block in section.blocks -%}
                <span class="flex flex-col items-center" {{ block.shopify_attributes }}>
                  {%- if block.settings.use_country_flag -%}
                    <img class="rounded" src="{{ localization.country | image_url: width: 72 }}" height="22" width="" alt="{{ localization.country.name | escape }}">
                  {%- elsif block.settings.icon != blank -%}
                    <img class="rounded" src="{{ block.settings.icon | image_url }}" height="22" width="" alt="{{ block.settings.label | escape }}">
                  {%- endif -%}
                  {%- if block.settings.label != blank -%}
                    <span class="leading-none text-xs mt-1 font-semibold">{{ block.settings.label }}</span>
                  {%- endif -%}
                </span>
              {%- endfor -%}
            </span>
          {%- endif -%}
        </div>
      {%- endif -%}

    </a>
  </div>

{% endunless %}


{% if section.settings.enable_badges %}
  {% if section.blocks.size > 0 %}

    <div class="mgx-tb-badges md:hidden py-3 border-0 border-t border-solid" style="background-color: {{ section.settings.primary_color }}; border-color: {{ section.settings.secondary_color | color_modify: 'alpha', 0.15 }};">

      <div class="page-width">

        <div class="mgx-tb-badges__row flex gap-2 justify-between">

          {% for block in section.blocks %}

            <div class="mgx-tb-badge flex flex-col items-center" {{ block.shopify_attributes }}>

              {% if block.settings.use_country_flag %}
                <img
                  class="mgx-tb-badge__icon rounded"
                  src="{{ localization.country | image_url: width: 72 }}"
                  height="25"
                  width=""
                  alt="{{ localization.country.name | escape }}">
              {% elsif block.settings.icon != blank %}
                <img
                  class="mgx-tb-badge__icon rounded"
                  src="{{ block.settings.icon | image_url }}"
                  height="25"
                  width=""
                  alt="{{ block.settings.label }}">
              {% endif %}

              {% if block.settings.label != blank %}
                <div class="mgx-tb-badge__label leading-none text-xs mt-1 font-semibold" style="color: {{ section.settings.secondary_color }};">
                  {{ block.settings.label }}
                </div>
              {% endif %}

            </div>

            {% unless forloop.last %}
              <div class="!block w-[1px] self-stretch" style="background-color: {{ section.settings.secondary_color | color_modify: 'alpha', 0.25 }};"></div>
            {% endunless %}

          {% endfor %}

        </div>

      </div>

    </div>

  {% endif %}
{% endif %}


{% if section.settings.enable_timer %}

  <script>
    (function () {
      var clock = document.querySelector('#shopify-section-{{ section.id }} [data-mgx-countdown]');
      if (!clock) return;
      var cells = {};
      clock.querySelectorAll('[data-unit]').forEach(function (el) { cells[el.dataset.unit] = el; });

      // "Countdown date" when it parses, else the next local midnight (rolls over every day)
      function deadline() {
        var set = Date.parse(clock.dataset.deadline || '');
        if (!isNaN(set) && set > Date.now()) return set;
        var midnight = new Date();
        midnight.setHours(24, 0, 0, 0);
        return midnight.getTime();
      }
      var end = deadline();
      function pad(n) { return (n < 10 ? '0' : '') + n; }
      function tick() {
        var left = Math.max(0, Math.floor((end - Date.now()) / 1000));
        if (left === 0 && !clock.dataset.deadline) { end = deadline(); left = Math.floor((end - Date.now()) / 1000); }
        var d = Math.floor(left / 86400);
        var h = Math.floor(left / 3600) - (cells.d ? d * 24 : 0);
        var values = { d: d, h: h, m: Math.floor(left / 60) % 60, s: left % 60 };
        for (var k in cells) {
          var text = pad(values[k]);
          if (cells[k].textContent !== text) cells[k].textContent = text;
        }
      }
      tick();
      setInterval(tick, 1000);
    })();
  </script>

{% endif %}


{% schema %}
  {
    "name": "Offer Timebar",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_top_bar",
        "label": "Enable Top Bar",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_timer",
        "label": "Enable Countdown Timer",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "enable_badges",
        "label": "Enable Badges",
        "default": true
      },
      {
        "type": "color",
        "id": "primary_color",
        "label": "Primary Color",
        "info": "Background of the whole top bar.",
        "default": "#100F0D"
      },
      {
        "type": "color",
        "id": "secondary_color",
        "label": "Secondary Color",
        "info": "Text in the top bar.",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "timer_box_color",
        "label": "Timer background (the countdown half)",
        "default": "#0B0B0B"
      },
      {
        "type": "color",
        "id": "timer_label_color",
        "label": "Timer label color",
        "default": "#C7C9CB"
      },
      {
        "type": "text",
        "id": "top_banner_text",
        "label": "Top Banner Text",
        "info": "Leaving this field empty will also disable the top banner."
      },
      {
        "type": "text",
        "id": "prepend_text",
        "label": "Prepend Text",
        "default": "Exclusive Offer"
      },
      {
        "type": "text",
        "id": "countdown_date",
        "label": "End Date and Time",
        "info": "Format: YYYY/MM/DD HH:MM:SS (e.g., 2026/12/25 23:59:59)"
      },
      {
        "type": "text",
        "id": "append_text",
        "label": "Append Text",
        "default": "Shop Now 👉"
      },
      {
        "type": "url",
        "id": "link",
        "label": "Link"
      }
    ],
    "blocks": [
      {
        "type": "payment_icon",
        "name": "Badge",
        "settings": [
          {
            "type": "checkbox",
            "id": "use_country_flag",
            "label": "Show the visitor's country flag",
            "info": "Uses the flag of the country the shopper browses in, instead of the icon below.",
            "default": false
          },
          {
            "type": "image_picker",
            "id": "icon",
            "label": "Icon"
          },
          {
            "type": "text",
            "id": "label",
            "label": "Label"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Offer Timebar"
      }
    ]
  }
{% endschema %}