{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  {% comment %} Trust row, same layout as the Whop store's (mx-trust). {% endcomment %}
  #{{ section.id }} .mgx-trust__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  #{{ section.id }} .mgx-trust__item {
    padding: 16px 24px;
    border-right: 1px solid {{ section.settings.divider_color }};
    text-align: center;
  }
  #{{ section.id }} .mgx-trust__item:last-child {
    border-right: 0;
  }
  #{{ section.id }} .mgx-trust__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 44px;
    margin: 0 auto 14px;
    color: {{ section.settings.icon_color }};
  }
  #{{ section.id }} .mgx-trust__icon svg {
    width: 36px;
    height: 36px;
  }
  #{{ section.id }} .mgx-trust__icon img {
    max-height: 36px;
    width: auto;
  }
  #{{ section.id }} .mgx-trust__title {
    margin: 0 0 6px;
    font-family: var(--font-body-family);
    font-size: 15px;
    line-height: 1.3;
    font-weight: 800;
    letter-spacing: 0.3px;
    color: var(--mgx-text);
  }
  #{{ section.id }} .mgx-trust__text {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.6;
    color: rgba(var(--mgx-black-rgb), 0.55);
  }

  @media screen and (max-width: 749px) {
    #{{ section.id }} .mgx-trust__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    #{{ section.id }} .mgx-trust__item {
      padding: 16px 12px;
      border-bottom: 1px solid {{ section.settings.divider_color }};
    }
    #{{ section.id }} .mgx-trust__item:nth-child(2n) {
      border-right: 0;
    }
    #{{ section.id }} .mgx-trust__item:nth-last-child(-n + 2):nth-child(2n + 1),
    #{{ section.id }} .mgx-trust__item:last-child {
      border-bottom: 0;
    }
    #{{ section.id }} .mgx-trust__title {
      font-size: 13px;
    }
    #{{ section.id }} .mgx-trust__text {
      font-size: 12.5px;
    }
  }
{%- endstyle -%}

<div
  id="{{ section.id }}"
  class="section-{{ section.id }}-padding"
  style="background-color: {{ section.settings.background_color }}">
  <div class="page-width">
    <div class="mgx-trust__grid">
      <div class="mgx-trust__item">
        <div class="mgx-trust__icon" aria-hidden="true">{% render 'trust-icon', name: section.settings.ships_icon %}</div>
        <h3 class="mgx-trust__title">Ships from {% render 'ships-from-location' %}</h3>
        <p class="mgx-trust__text">Carefully packed and delivered to your door in just 5 business days.</p>
      </div>
      {% for block in section.blocks %}
        <div class="mgx-trust__item" {{ block.shopify_attributes }}>
          <div class="mgx-trust__icon" aria-hidden="true">
            {%- if block.settings.icon == 'image' -%}
              {%- if block.settings.perk_image != blank -%}
                <img
                  src="{{ block.settings.perk_image | image_url: width: 150 }}"
                  loading="lazy"
                  height="{{ block.settings.perk_image.height }}"
                  width="{{ block.settings.perk_image.width }}"
                  alt="">
              {%- endif -%}
            {%- else -%}
              {% render 'trust-icon', name: block.settings.icon %}
            {%- endif -%}
          </div>
          <h3 class="mgx-trust__title">{{ block.settings.perk_title }}</h3>
          <p class="mgx-trust__text">{{ block.settings.perk_content }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "Features Ships from",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "label": "Background Color",
        "default": "#ffffff"
      }, {
        "type": "select",
        "id": "ships_icon",
        "label": "\"Ships from\" icon",
        "options": [
          { "value": "box", "label": "Box" },
          { "value": "truck", "label": "Truck" },
          { "value": "bottle", "label": "Bottle" },
          { "value": "drop", "label": "Drop" },
          { "value": "shield", "label": "Shield" },
          { "value": "clock", "label": "Clock" }
        ],
        "default": "box"
      }, {
        "type": "color",
        "id": "icon_color",
        "label": "Icon color",
        "default": "#9A5B1E"
      }, {
        "type": "color",
        "id": "divider_color",
        "label": "Divider color",
        "default": "#E6E7E8"
      }, {
        "type": "header",
        "content": "t:sections.all.padding.section_padding_heading"
      }, {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 36
      }, {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 36
      }
    ],
    "blocks": [
      {
        "type": "perks",
        "name": "Perks",
        "settings": [
          {
            "type": "select",
            "id": "icon",
            "label": "Icon",
            "options": [
              { "value": "image", "label": "Use the perk image" },
              { "value": "box", "label": "Box" },
              { "value": "truck", "label": "Truck" },
              { "value": "bottle", "label": "Bottle" },
              { "value": "drop", "label": "Drop" },
              { "value": "shield", "label": "Shield" },
              { "value": "clock", "label": "Clock" }
            ],
            "default": "image"
          }, {
            "type": "image_picker",
            "id": "perk_image",
            "label": "Perk Image"
          }, {
            "type": "text",
            "id": "perk_title",
            "label": "Perk Title",
            "default": "Perk Title"
          }, {
            "type": "text",
            "id": "perk_content",
            "label": "Perk Content",
            "default": "Perk Content"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Features Ships from"
      }
    ]
  }
{% endschema %}
