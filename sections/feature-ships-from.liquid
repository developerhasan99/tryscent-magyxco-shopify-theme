{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  id="{{ section.id }}"
  class="section-{{ section.id }}-padding"
  style="background-color: {{ section.settings.background_color }}">
  <div class="page-width">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-8">
      <div class="flex flex-col items-center gap-1">
        <img
          class="h-7 md:h-10 w-auto"
          src="/cdn/shop/files/Screenshot_2026-02-03_at_12.00.15_PM.webp?v=1771402872&amp;width=150"
          loading="lazy"
          height="110"
          width="150"
          alt="Perk Image">
        <h3 class="text-base md:text-lg my-0 text-center font-semibold text-black">Ships from {% render 'ships-from-location' %}</h3>
        <p class="text-sm md:text-base my-0 text-center text-slate-700">Carefully packed and delivered to your door in just 5 business days.</p>
      </div>
      {% for block in section.blocks %}
        <div class="flex flex-col items-center gap-1" {{ block.shopify_attributes }}>
          <img
            class="h-7 md:h-10 w-auto"
            src="{{ block.settings.perk_image | image_url: width: 150 }}"
            loading="lazy"
            height="{{ block.settings.perk_image.height }}"
            width="{{ block.settings.perk_image.width }}"
            alt="Perk Image">
          <h3 class="text-base md:text-lg my-0 text-center font-semibold text-black">{{ block.settings.perk_title }}</h3>
          <p class="text-sm md:text-base my-0 text-center text-slate-700">{{ block.settings.perk_content }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "Features Ships from",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "label": "Background Color",
        "default": "#fcfbf9"
      }, {
        "type": "header",
        "content": "t:sections.all.padding.section_padding_heading"
      }, {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 36
      }, {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 36
      }
    ],
    "blocks": [
      {
        "type": "perks",
        "name": "Perks",
        "settings": [
          {
            "type": "image_picker",
            "id": "perk_image",
            "label": "Perk Image"
          }, {
            "type": "text",
            "id": "perk_title",
            "label": "Perk Title",
            "default": "Perk Title"
          }, {
            "type": "text",
            "id": "perk_content",
            "label": "Perk Content",
            "default": "Perk Content"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Features Ships from"
      }
    ]
  }
{% endschema %}