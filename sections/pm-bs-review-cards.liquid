{{ 'pm-bs-base.css' | asset_url | stylesheet_tag }}
{{ 'pm-s-bs-review-cards.css' | asset_url | stylesheet_tag }}
{%- style -%}
  .pm-scope .pm-bsrc--{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  @media screen and (min-width: 990px) {
    .pm-scope .pm-bsrc--{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  id="{{ section.id }}"
  class="pm-bsrc pm-bsrc--{{ section.id }} color-{{ section.settings.color_scheme }} gradient"
  data-pm-bsrc
  data-label-sound="{{ section.settings.sound_label | escape }}"
  data-label-mute="{{ section.settings.mute_label | escape }}">
  <div class="page-width">
    <div class="pm-bsrc__head">
      {%- if section.settings.rating_text != blank -%}
        <p class="pm-bsrc__rating">
          {% render 'pm-stars', rating: 4.9, size: 12 %}
          <span class="pm-small">{{ section.settings.rating_text }}</span>
        </p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="pm-h2 pm-bsrc__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="pm-body-lg pm-muted pm-bsrc__sub">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="pm-bsrc__stage">
      <button type="button" class="pm-bsrc__arrow pm-bsrc__arrow--prev" data-prev aria-label="{{ section.settings.prev_label | escape }}" disabled>
        {% render 'pm-icon', icon: 'chevron-right', size: 18, stroke: 1.5 %}
      </button>
      <ul class="pm-bsrc__track" data-track role="list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign rating = block.settings.rating | default: 5 | plus: 0

            # A card with a video plays the clip instead of the photo. Liquid
            # lists two sources for a Files video, an m3u8 and one mp4 (the
            # 1080p transcode, 606px wide for a 9:16 clip: right for a ~250px
            # card on a 3x phone screen). The smaller CDN renditions carry a
            # per-clip bitrate in their names, so they can't be derived here.
            assign clip = block.settings.video
            assign clip_src = block.settings.video_url | strip
            if clip != blank
              for source in clip.sources
                if source.format == 'mp4'
                  assign clip_src = source.url
                  break
                endif
              endfor
            endif
            assign has_video = false
            if clip_src != blank
              assign has_video = true
            endif

            # Poster: the picked photo, else the frame Shopify made for a Files
            # clip. A pasted link has neither, so #t makes iOS paint frame 0.
            assign poster = block.settings.image
            if poster == blank and clip != blank
              assign poster = clip.preview_image
            endif
            if has_video and poster == blank
              unless clip_src contains '#'
                assign clip_src = clip_src | append: '#t=0.001'
              endunless
            endif

            assign has_review = false
            if block.settings.headline != blank or block.settings.quote != blank
              assign has_review = true
            endif
          -%}
          {%- if has_video -%}
          <li class="pm-bsrc__card pm-bsrc__card--video" data-card {{ block.shopify_attributes }}>
            <div class="pm-bsrc__media pm-bsrc__media--video" data-clip>
              <video
                class="pm-bsrc__video"
                data-video
                muted
                playsinline
                loop
                preload="{% if poster != blank %}none{% else %}metadata{% endif %}"
                {% if poster != blank %}poster="{{ poster | image_url: width: 720 }}"{% endif %}
                aria-hidden="true">
                <source src="{{ clip_src }}" type="video/mp4">
              </video>
              <button
                type="button"
                class="pm-bsrc__sound"
                data-sound
                aria-pressed="false"
                data-name="{{ block.settings.author | escape }}"
                aria-label="{{ section.settings.sound_label | escape }}{% if block.settings.author != blank %}: {{ block.settings.author | escape }}{% endif %}">
                <span class="pm-bsrc__sound-icon" aria-hidden="true">
                  <svg class="pm-bsrc__sound-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M11 5 6 9H2v6h4l5 4V5z"/><path d="m23 9-6 6M17 9l6 6"/></svg>
                  <svg class="pm-bsrc__sound-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M11 5 6 9H2v6h4l5 4V5z"/><path d="M15.5 8.5a5 5 0 0 1 0 7M19 5a10 10 0 0 1 0 14"/></svg>
                </span>
              </button>
            </div>
            {%- if has_review or block.settings.author != blank -%}
            <div class="pm-bsrc__body">
              {%- if has_review -%}
              <span class="pm-bsrc__stars" role="img" aria-label="{{ 'premium.general.rating_aria' | t: rating: rating }}">
                {%- for i in (1..5) -%}
                  <svg{% if i > rating %} class="is-empty"{% endif %} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                {%- endfor -%}
              </span>
              {%- endif -%}
              {%- if block.settings.headline != blank -%}
                <h3 class="pm-bsrc__headline">{{ block.settings.headline }}</h3>
              {%- endif -%}
              {%- if block.settings.quote != blank -%}
                <p class="pm-bsrc__quote">&ldquo;{{ block.settings.quote | escape }}&rdquo;</p>
              {%- endif -%}
              {%- if block.settings.author != blank -%}
                <p class="pm-bsrc__author">{{ block.settings.author }}</p>
              {%- endif -%}
            </div>
            {%- endif -%}
          </li>
          {%- else -%}
          <li class="pm-bsrc__card" data-card {{ block.shopify_attributes }}>
            <div class="pm-bsrc__media">
              {%- if block.settings.image != blank -%}
                <img
                  class="pm-bsrc__img"
                  src="{{ block.settings.image | image_url: width: 540 }}"
                  srcset="{{ block.settings.image | image_url: width: 360 }} 360w, {{ block.settings.image | image_url: width: 540 }} 540w, {{ block.settings.image | image_url: width: 720 }} 720w"
                  sizes="(min-width: 990px) 25vw, (min-width: 750px) 33vw, 72vw"
                  alt="{{ block.settings.image.alt | default: block.settings.author | escape }}"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  loading="lazy">
              {%- elsif block.settings.image_url != blank -%}
                <img
                  class="pm-bsrc__img"
                  src="{{ block.settings.image_url }}"
                  alt="{{ block.settings.author | escape }}"
                  width="720"
                  height="900"
                  loading="lazy">
              {%- endif -%}
            </div>
            <div class="pm-bsrc__body">
              <span class="pm-bsrc__stars" role="img" aria-label="{{ 'premium.general.rating_aria' | t: rating: rating }}">
                {%- for i in (1..5) -%}
                  <svg{% if i > rating %} class="is-empty"{% endif %} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                {%- endfor -%}
              </span>
              {%- if block.settings.headline != blank -%}
                <h3 class="pm-bsrc__headline">{{ block.settings.headline }}</h3>
              {%- endif -%}
              {%- if block.settings.quote != blank -%}
                <p class="pm-bsrc__quote">&ldquo;{{ block.settings.quote | escape }}&rdquo;</p>
              {%- endif -%}
              {%- if block.settings.author != blank -%}
                <p class="pm-bsrc__author">{{ block.settings.author }}</p>
              {%- endif -%}
              {%- if block.settings.tag_1 != blank or block.settings.tag_2 != blank -%}
                <p class="pm-bsrc__tags">
                  {%- if block.settings.tag_1 != blank -%}<span class="pm-bsrc__tag">{{ block.settings.tag_1 }}</span>{%- endif -%}
                  {%- if block.settings.tag_2 != blank -%}<span class="pm-bsrc__tag">{{ block.settings.tag_2 }}</span>{%- endif -%}
                </p>
              {%- endif -%}
            </div>
          </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
      <button type="button" class="pm-bsrc__arrow pm-bsrc__arrow--next" data-next aria-label="{{ section.settings.next_label | escape }}">
        {% render 'pm-icon', icon: 'chevron-right', size: 18, stroke: 1.5 %}
      </button>
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('{{ section.id }}');
    if (!root || root.hasAttribute('data-started')) return;
    root.setAttribute('data-started', '1');

    var track = root.querySelector('[data-track]');
    var prev = root.querySelector('[data-prev]');
    var next = root.querySelector('[data-next]');
    if (!track) return;

    function stepSize() {
      var card = track.querySelector('[data-card]');
      if (!card) return track.clientWidth;
      var gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return card.getBoundingClientRect().width + gap;
    }

    function update() {
      var max = track.scrollWidth - track.clientWidth - 2;
      if (prev) prev.disabled = track.scrollLeft <= 2;
      if (next) next.disabled = track.scrollLeft >= max;
    }

    function go(dir) {
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      track.scrollBy({ left: dir * stepSize(), behavior: reduce ? 'auto' : 'smooth' });
    }

    if (prev) prev.addEventListener('click', function () { go(-1); });
    if (next) next.addEventListener('click', function () { go(1); });
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();

    // Video cards: a muted preview plays while at least 60% of the clip is on
    // screen and pauses off screen (no autoplay with reduced motion). A tap
    // plays that clip with sound from the start and mutes the others; a second
    // tap mutes it again. A clip that leaves the screen goes back to muted.
    var clips = Array.prototype.slice.call(root.querySelectorAll('[data-clip]'));
    if (!clips.length) return;
    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var labelSound = root.getAttribute('data-label-sound') || 'Play with sound';
    var labelMute = root.getAttribute('data-label-mute') || 'Mute video';

    function videoOf(clip) {
      return clip.querySelector('[data-video]');
    }

    function play(video) {
      var p = video.play();
      if (p && p.catch) p.catch(function () {});
    }

    function setSound(clip, on) {
      var video = videoOf(clip);
      var btn = clip.querySelector('[data-sound]');
      if (video) video.muted = !on;
      clip.classList.toggle('is-sound-on', on);
      if (btn) {
        var name = btn.getAttribute('data-name');
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
        btn.setAttribute('aria-label', (on ? labelMute : labelSound) + (name ? ': ' + name : ''));
      }
    }

    clips.forEach(function (clip) {
      var btn = clip.querySelector('[data-sound]');
      var video = videoOf(clip);
      if (!btn || !video) return;
      btn.addEventListener('click', function () {
        if (clip.classList.contains('is-sound-on')) {
          setSound(clip, false);
          if (reduceMotion) video.pause();
          return;
        }
        clips.forEach(function (other) {
          if (other === clip || !other.classList.contains('is-sound-on')) return;
          setSound(other, false);
          if (reduceMotion) videoOf(other).pause();
        });
        setSound(clip, true);
        try {
          video.currentTime = 0;
        } catch (e) {}
        play(video);
      });
    });

    if (reduceMotion || !('IntersectionObserver' in window)) return;
    var observer = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        var video = videoOf(entry.target);
        if (!video) return;
        if (entry.isIntersecting) {
          play(video);
        } else {
          video.pause();
          if (entry.target.classList.contains('is-sound-on')) setSound(entry.target, false);
        }
      });
    }, { threshold: 0.6 });
    clips.forEach(function (clip) {
      observer.observe(clip);
    });
  })();
</script>

{% schema %}
{
  "name": "BS Review cards",
  "tag": "section",
  "class": "pm-scope",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating line",
      "default": "Excellent 4.9"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Turn heads everywhere you go"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "From subtle glances to bold compliments"
    },
    {
      "type": "text",
      "id": "prev_label",
      "label": "Previous arrow label",
      "default": "Previous reviews"
    },
    {
      "type": "text",
      "id": "next_label",
      "label": "Next arrow label",
      "default": "Next reviews"
    },
    {
      "type": "text",
      "id": "sound_label",
      "label": "Video sound button label (screen readers)",
      "default": "Play with sound"
    },
    {
      "type": "text",
      "id": "mute_label",
      "label": "Video mute button label (screen readers)",
      "default": "Mute video"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Review",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "A video replaces the photo and plays muted while on screen; a tap plays it with sound. The photo becomes the video's cover. Stars show only when the card has a headline or quote."
        },
        {
          "type": "text",
          "id": "video_url",
          "label": "Video URL (.mp4, used only when no video is picked)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "image_url",
          "label": "Photo URL (used only when no photo is picked)"
        },
        {
          "type": "text",
          "id": "headline",
          "label": "Headline"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote (quotation marks are added automatically)"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Name"
        },
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Stars",
          "default": 5
        },
        {
          "type": "text",
          "id": "tag_1",
          "label": "Tag 1"
        },
        {
          "type": "text",
          "id": "tag_2",
          "label": "Tag 2"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "BS Review cards",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
