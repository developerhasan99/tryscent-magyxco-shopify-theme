ock;}\n\n/* ==== HERO ==== */\n.tryscent-listicle .ts-hero{\n  background:var(--green);\n  color:var(--white);\n  padding:48px 24px 0;\n  position:relative;\n  overflow:hidden;\n}\n.tryscent-listicle .ts-hero::before{\n  content:\"\";\n  position:absolute;\n  top:-120px;right:-120px;\n  width:340px;height:340px;\n  border-radius:50%;\n  background:radial-gradient(circle at 30% 30%, rgba(255,255,255,0.18), rgba(34,97,58,0) 65%);\n  pointer-events:none;\n}\n.tryscent-listicle .ts-hero::after{\n  content:\"\";\n  position:absolute;\n  top:-40px;right:60px;\n  width:120px;height:120px;\n  border:1px solid rgba(255,255,255,0.35);\n  border-radius:50%;\n  pointer-events:none;\n}\n.tryscent-listicle .ts-hero-inner{\n  max-width:1200px;\n  margin:0 auto;\n  display:grid;\n  grid-template-columns:1.25fr 1fr;\n  gap:48px;\n  align-items:center;\n  position:relative;\n  z-index:2;\n}\n.tryscent-listicle .ts-hero-copy h1{\n  font-weight:800;\n  font-size:clamp(24px, 2.2vw, 32px);\n  line-height:1.15;\n  letter-spacing:-0.01em;\n  margin-bottom:16px;\n  text-align:center;\n  color:var(--white);\n}\n.tryscent-listicle .ts-hero-copy h1 .ts-light{\n  font-weight:700;\n  font-size:clamp(12px, 1.05vw, 15px);\n  letter-spacing:0.16em;\n  text-transform:uppercase;\n  color:var(--beige);\n  display:block;\n  margin-bottom:12px;\n}\n.tryscent-listicle .ts-hero-copy .ts-sub{\n  font-size:clamp(14px, 1.15vw, 16px);\n  line-height:1.5;\n  color:rgba(250,249,246,0.85);\n  max-width:600px;\n  margin:0 auto;\n  text-align:center;\n}\n.tryscent-listicle .ts-hero-img{\n  position:relative;\n  aspect-ratio:4/3;\n  background:#1a1d26;\n  overflow:hidden;\n}\n.tryscent-listicle .ts-hero-img img{width:100%;height:100%;object-fit:cover;}\n\n/* ==== TRUST BAR ==== */\n.tryscent-listicle .ts-trustbar{\n  background:var(--green-dark);\n  border-top:1px solid rgba(255,255,255,0.10);\n  padding:18px 0;\n  overflow:hidden;\n}\n.tryscent-listicle .ts-trustbar-track{\n  display:flex;\n  width:max-content;\n  animation:tsTrustMarquee 24s linear infinite;\n}\n.tryscent-listicle .ts-trustbar-item{\n  display:flex;\n  align-items:center;\n  gap:10px;\n  color:var(--white);\n  font-size:13px;\n  font-weight:600;\n  letter-spacing:0.05em;\n  white-space:nowrap;\n  margin-right:64px;\n}\n@keyframes tsTrustMarquee{\n  from{transform:translateX(0);}\n  to{transform:translateX(-50%);}\n}\n.tryscent-listicle .ts-trustbar-item svg{width:20px;height:20px;flex-shrink:0;stroke:var(--white);fill:none;stroke-width:1.6;}\n\n/* ==== LISTICLE ==== */\n.tryscent-listicle .ts-listicle-wrap{\n  background:var(--beige);\n  padding:80px 24px;\n}\n.tryscent-listicle .ts-listicle-inner{\n  max-width:900px;\n  margin:0 auto;\n  display:flex;\n  flex-direction:column;\n  gap:64px;\n}\n.tryscent-listicle .ts-point{\n  display:grid;\n  grid-template-columns:280px 1fr;\n  gap:36px;\n  align-items:start;\n}\n.tryscent-listicle .ts-point-img{\n  position:relative;\n  aspect-ratio:1/1;\n  background:#e8e6df;\n  overflow:hidden;\n}\n.tryscent-listicle .ts-point-img img{width:100%;height:100%;object-fit:cover;}\n.tryscent-listicle .ts-point-num{\n  position:absolute;\n  top:0;left:0;\n  width:48px;height:48px;\n  background:var(--black);\n  color:var(--white);\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  font-weight:800;\n  font-size:22px;\n  z-index:2;\n}\n.tryscent-listicle .ts-point-body h3{\n  font-weight:800;\n  font-size:clamp(20px, 2.4vw, 26px);\n  line-height:1.15;\n  letter-spacing:-0.01em;\n  margin-bottom:14px;\n  text-transform:uppercase;\n  color:var(--black);\n}\n.tryscent-listicle .ts-point-body p{\n  font-size:16px;\n  line-height:1.65;\n  color:#2a2a2a;\n  margin-bottom:12px;\n}\n.tryscent-listicle .ts-point-body p:last-child{margin-bottom:0;}\n.tryscent-listicle .ts-point-body strong{font-weight:700;color:var(--black);}\n.tryscent-listicle .ts-badge-60{\n  position:absolute;\n  bottom:14px;right:14px;\n  width:88px;height:88px;\n  padding:6px;\n  background:radia