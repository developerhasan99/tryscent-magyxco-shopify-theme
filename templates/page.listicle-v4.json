  stroke:var(--white);\n  fill:none;\n  stroke-width:2.5;\n  margin-top:2px;\n}\n.tryscent-listicle .ts-proof-carousel{\n  position:relative;\n  margin:0 0 32px;\n  -webkit-mask-image:linear-gradient(90deg, transparent 0, #000 6%, #000 94%, transparent 100%);\n  mask-image:linear-gradient(90deg, transparent 0, #000 6%, #000 94%, transparent 100%);\n}\n.tryscent-listicle .ts-carousel-track{\n  display:flex;\n  gap:4px;\n  width:max-content;\n  animation:tsCarousel 60s linear infinite;\n}\n.tryscent-listicle .ts-proof-carousel:hover .ts-carousel-track{animation-play-state:paused;}\n.tryscent-listicle .ts-carousel-card{\n  width:180px;\n  aspect-ratio:1/1;\n  flex-shrink:0;\n  overflow:hidden;\n  background:#0f1218;\n}\n.tryscent-listicle .ts-carousel-card img{width:100%;height:100%;object-fit:cover;display:block;}\n@keyframes tsCarousel{\n  from{transform:translateX(0);}\n  to{transform:translateX(calc(var(--ts-card-step, 184px) * -10));}\n}\n.tryscent-listicle .ts-proof-reviews-tag{\n  max-width:1100px;\n  margin:0 auto;\n  background:var(--white);\n  color:var(--black);\n  text-align:center;\n  padding:14px;\n  font-weight:800;\n  font-size:14px;\n  letter-spacing:0.15em;\n  text-transform:uppercase;\n}\n\n/* ==== MARQUEE ==== */\n.tryscent-listicle .ts-marquee{\n  background:var(--green-dark);\n  color:var(--white);\n  overflow:hidden;\n  border-top:1px solid rgba(255,255,255,0.10);\n  border-bottom:1px solid rgba(255,255,255,0.10);\n}\n.tryscent-listicle .ts-marquee-track{\n  display:flex;\n  gap:48px;\n  padding:18px 0;\n  white-space:nowrap;\n  animation:tsMarquee 28s linear infinite;\n  width:max-content;\n}\n.tryscent-listicle .ts-marquee-track span{\n  font-weight:800;\n  font-size:14px;\n  letter-spacing:0.25em;\n  text-transform:uppercase;\n}\n.tryscent-listicle .ts-marquee-track span::after{\n  content:\"·\";\n  margin-left:48px;\n  opacity:0.6;\n}\n@keyframes tsMarquee{\n  from{transform:translateX(0);}\n  to{transform:translateX(-50%);}\n}\n\n/* ==== QUO