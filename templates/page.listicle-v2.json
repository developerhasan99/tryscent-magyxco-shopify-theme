chase</span>\n      <span>EU-made · IFRA-certified</span>\n    </div>\n  </div>\n\n <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&display=swap\" rel=\"stylesheet\">\n\n<style>\n.ts-listicle-offer{\n  --lo-accent:#C41E3A;\n  --lo-accent-hover:#A51D36;\n  --lo-fg:#121212;\n  --lo-fg-muted:#5a5a5a;\n  --lo-bg:#faf9f6;\n  --lo-rule:#e5e1d8;\n  font-family:'Figtree',-apple-system,BlinkMacSystemFont,system-ui,sans-serif;\n  color:var(--lo-fg);\n  background:var(--lo-bg);\n  -webkit-font-smoothing:antialiased;\n  -moz-osx-font-smoothing:grayscale;\n}\n.ts-listicle-offer *{box-sizing:border-box;}\n.ts-listicle-offer img{max-width:100%;height:auto;display:block;}\n\n.ts-listicle-offer .ts-offer-section{\n  padding:56px 32px 72px;\n  max-width:980px;\n  margin:0 auto;\n}\n\n.ts-listicle-offer .ts-pullquote{\n  font-size:32px;\n  line-height:1.2;\n  font-weight:800;\n  letter-spacing:-0.01em;\n  text-align:center;\n  margin:0 auto 40px;\n  max-width:760px;\n  color:var(--lo-fg);\n}\n.ts-listicle-offer .ts-pullquote::before,\n.ts-listicle-offer .ts-pullquote::after{\n  content:'\"';\n  color:var(--lo-accent);\n}\n\n.ts-listicle-offer .ts-offer-card{\n  background:#fff;\n  border:1px solid var(--lo-rule);\n  border-radius:8px;\n  max-width:640px;\n  margin:0 auto;\n  overflow:hidden;\n  box-shadow:0 6px 28px rgba(0,0,0,0.06);\n}\n\n.ts-listicle-offer .ts-offer-headline{\n  font-size:26px;\n  line-height:1.2;\n  font-weight:800;\n  letter-spacing:-0.01em;\n  margin:0;\n  padding:28px 28px 18px;\n  text-align:center;\n  color:var(--lo-fg);\n}\n\n.ts-listicle-offer .ts-offer-image{\n  background:var(--lo-bg);\n  aspect-ratio:4/3;\n  overflow:hidden;\n}\n.ts-listicle-offer .ts-offer-image img{\n  width:100%;height:100%;\n  object-fit:contain;\n}\n\n.ts-listicle-offer .ts-offer-body{\n  padding:24px 28px 28px;\n}\n\n.ts-listicle-offer .ts-offer-stars{\n  text-align:center;\n  color:#d4a017;\n  font-size:14px;\n  margin:0 0 14px;\n  letter-spacing:0.06em;\n}\n.ts-listicle-offer .ts-offer-stars span{\n  color:var(--lo-fg-muted);\n  font-size:12px;\n  margin-left:6px;\n  letter-spacing:0;\n}\n\n.ts-listicle-offer .ts-offer-desc{\n  font-size:15px;\n  line-height:1.55;\n  color:var(--lo-fg);\n  margin:0 0 20px;\n  text-align:center;\n}\n\n.ts-listicle-offer .ts-offer-bullets{\n  list-style:none;\n  margin:0 0 24px;\n  padding:0;\n  display:flex;\n  flex-direction:column;\n  gap:9px;\n}\n.ts-listicle-offer .ts-offer-bullets li{\n  display:flex;\n  align-items:center;\n  gap:10px;\n  font-size:14px;\n  font-weight:600;\n  color:var(--lo-fg);\n}\n.ts-listicle-offer .ts-offer-bullets svg{\n  width:14px;height:14px;\n  stroke:#1f3a2a;\n  fill:none;\n  stroke-width:3;\n  flex-shrink:0;\n}\n\n.ts-listicle-offer .ts-cta{\n  display:block;\n  width:100%;\n  background:var(--lo-accent);\n  color:#fff;\n  text-decoration:none;\n  font-weight:800;\n  font-size:15px;\n  letter-spacing:0.06em;\n  text-transform:uppercase;\n  text-align:center;\n  padding:18px 24px;\n  border-radius:999px;\n  transition:background 0.15s ease;\n  box-sizing:border-box;\n  line-height:1.2;\n}\n.ts-listicle-offer .ts-cta:hover{background:var(--lo-accent-hover);color:#fff;}\n\n.ts-listicle-offer .ts-cta-sub{\n  text-align:center;\n  margin:12px 0 0;\n  font-size:12px;\n  color:var(--lo-fg-muted);\n  letter-spacing:0.04em;\n}\n\n@media (max-width:540px){\n  .ts-listicle-offer .ts-offer-section{padding:40px 20px 56px;}\n  .ts-listicle-offer .ts-pullquote{font-size:24px;margin-bottom:32px;}\n  .ts-listicle-offer .ts-offer-headline{font-size:20px;padding:22px 22px 14px;}\n  .ts-listicle-offer .ts-offer-image{aspect-ratio:1/1;}\n  .ts-listicle-offer .ts-offer-body{padding:20px 22px 24px;}\n  .ts-listicle-offer .ts-offer-desc{font-size:14px;}\n  .ts-listicle-offer .ts-cta{font-size:13px;padding:16px 20px;letter-spacing:0.05em;}\n}\n</style>\n\n<div class=\"ts-listicle-offer\">\n  <section class=\"ts-offer-section\">\n    <div class=\"ts-pullquote\">Not Even The Original Smells This Good — And It Costs Less Than One Bottle</div>\n\n    <div class=\"ts-offer-card\">\n      <h3 class=\"ts-offer-headline\">TryScent 3-Bottle Bundle</h3>\n      <div class=\"ts-offer-image\">\n        <img src=\"https://tryscent.co/cdn/shop/files/3x100_swe.webp?v=1773821114\" alt=\"TryScent 3-bottle bundle\">\n      </div>\n      <div class=\"ts-offer-body\">\n        <div class=\"ts-offer-stars\">★★★★★ <span>10,000+ 5-star reviews</span></div>\n        <p class=\"ts-offer-desc\">Designer-inspired scents, formulated to smell the same — without the 1,600 kr markup for the packaging, the ads and the celebrity.</p>\n        <ul class=\"ts-offer-bullets\">\n          <li><svg viewBox=\"0 0 24 24\"><polyline points=\"4,12 10,18 20,6\"/></svg> Up to 21% EDP concentration</li>\n          <li><svg viewBox=\"0 0 24 24\"><polyline points=\"4,12 10,18 20,6\"/></svg> 12+ hours of longevity</li>\n          <li><svg viewBox=\"0 0 24 24\"><polyline points=\"4,12 10,18 20,6\"/></svg> EU-made · IFRA-certified</li>\n          <li><svg viewBox=\"0 0 24 24\"><polyline points=\"4,12 10,18 20,6\"/></svg> Clean Label cosmetics</li>\n          <li><svg viewBox=\"0 0 24 24\"><polyline points=\"4,12 10,18 20,6\"/></svg> Vegan · Cruelty-free</li>\n        </ul>\n        <a href=\"https://tryscent.co/sv-se/products/3x-100ml-perfume-bottles\" class=\"ts-cta\">See Bundle Save Big</a>\n        <p class=\"ts-cta-sub\">Free shipping over 483 kr · 60-day open purchase · Easy returns</p>\n      </div>\n    </div>\n  </section>\n</div>",
