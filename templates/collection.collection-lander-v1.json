        "custom_liquid": "<!-- Magyx &#8212; Social proof (Swedish) &#8212; Custom Liquid paste block.\n     Pure HTML+CSS+JS, scoped to .ts-proof-sv. No Liquid tags (Custom Liquid editor rejects them). -->\n<style>\n.ts-proof-sv{font-family:Inter,Arial,Helvetica,sans-serif;color:#111315;background:#fff;padding:48px 0;overflow:hidden}\n.ts-proof-sv *{box-sizing:border-box;margin:0}\n.ts-proof-sv .container{width:min(860px,calc(100% - 36px));margin-inline:auto}\n.ts-proof-sv .proof-head{text-align:center;max-width:640px;margin:0 auto 30px}\n.ts-proof-sv .stars-lg,.ts-proof-sv .review-stars{display:flex;gap:3px}\n.ts-proof-sv .stars-lg{justify-content:center;margin-bottom:14px}\n.ts-proof-sv .stars-lg span,.ts-proof-sv .review-stars span{display:grid;place-items:center;background:#00b67a}\n.ts-proof-sv .stars-lg span.off,.ts-proof-sv .review-stars span.off{background:#dcdce6}\n.ts-proof-sv .stars-lg span{width:28px;height:28px}\n.ts-proof-sv .review-stars span{width:15px;height:15px}\n.ts-proof-sv svg{fill:#fff;width:76%;height:76%}\n.ts-proof-sv .kicker{font-size:12px;letter-spacing:.13em;text-transform:uppercase;font-weight:800;color:#00b67a;margin-bottom:10px}\n.ts-proof-sv .section-title{font-size:26px;line-height:1.25;font-weight:800;color:#121212}\n.ts-proof-sv .carousel{display:flex;gap:16px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding:4px 2px 8px}\n.ts-proof-sv .carousel::-webkit-scrollbar{display:none}\n.ts-proof-sv .review-card{flex:0 0 calc((100% - 32px) / 3);scroll-snap-align:start;display:flex;flex-direction:column;background:#fff;border:1px solid #e8e8e8;border-radius:10px;padding:16px 16px 14px;box-shadow:0 1px 4px rgba(0,0,0,.05)}\n.ts-proof-sv .review-top{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px}\n.ts-proof-sv .verified{font-size:11px;color:rgba(0,0,0,.55);white-space:nowrap;text-decoration:none}\n.ts-proof-sv .verified:hover{text-decoration:underline}\n.ts-proof-sv .tp-dot{color:#00b67a}\n.ts-proof-sv .review-card h3{margin-bottom:8px;font-size:14px;line-height:1.4;font-weight:700;color:#121212}\n.ts-proof-sv .review-card p{margin-bottom:8px;font-size:13px;line-height:1.6;color:rgba(0,0,0,.62)}\n.ts-proof-sv .review-card p.result-line{font-weight:600;color:#121212;margin-bottom:12px}\n.ts-proof-sv .person{margin-top:auto;font-size:13px;color:#121212}\n.ts-proof-sv .person strong{display:block;font-size:13px}\n.ts-proof-sv .person span{display:block;font-size:11px;line-height:1.35;color:rgba(0,0,0,.55)}\n.ts-proof-sv .nav{display:flex;align-items:center;justify-content:center;gap:16px;margin-top:18px}\n.ts-proof-sv .arrow{width:40px;height:40px;border-radius:50%;border:1px solid #d6d6d6;background:#fff;color:#121212;font-size:22px;line-height:1;cursor:pointer;display:grid;place-items:center;padding:0 0 3px;transition:background .2s,color .2s,border-color .2s}\n.ts-proof-sv .arrow:hover{background:#121212;border-color:#121212;color:#fff}\n.ts-proof-sv .arrow:disabled{opacity:.35;cursor:default;background:#fff;color:#121212;border-color:#d6d6d6}\n.ts-proof-sv .dots{display:flex;gap:0}\n.ts-proof-sv .dot{box-sizing:content-box;width:8px;height:8px;border-radius:50%;border:0;padding:8px 5px;background:#d9d9d9;background-clip:content-box;cursor:pointer}\n.ts-proof-sv .dot.active{background:#00b67a;background-clip:content-box}\n@media(max-width:749px){\n  .ts-proof-sv{padding:32px 0}\n  .ts-proof-sv .container{width:100%}\n  .ts-proof-sv .proof-head{padding:0 18px;margin-bottom:22px}\n  .ts-proof-sv .stars-lg span{width:24px;height:24px}\n  .ts-proof-sv .section-title{font-size:22px}\n  .ts-proof-sv .carousel{gap:12px;padding:4px 18px 8px;scroll-padding-left:18px}\n  .ts-proof-sv .review-card{flex-basis:82%}\n  .ts-proof-sv .arrow{display:none}\n}\n</style>\n<section class=\"ts-proof-sv\">\n  <div class=\"container\">\n    <div class=\"proof-head\">\n      <div class=\"stars-lg\" role=\"img\" aria-label=\"5 out of 5 stars\"><span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2.5l2.9 6.6 7.1.6-5.4 4.7 1.6 7-6.2-3.7-6.2 3.7 1.6-7L2 9.7l7.1-.6z\"/></svg></span><span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2.5l2.9 6.6 7.1.6-5.4 4.7 1.6 7-6.2-3.7-6.2 3.7 1.6-7L2 9.7l7.1-.6z\"/></svg></span><span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2.5l2.9 6.6 7.1.6-5.4 4.7 1.6 7-6.2-3.7-6.2 3.7 1.6-7L2 9.7l7.1-.6z\"/></svg></span><span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2.5l2.9 6.6 7.1.6-5.4 4.7 1.6 7-6.2-3.7-6.2 3.7 1.6-7L2 9.7l7.1-.6z\"/></svg></span><span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2.5l2.9 6.6 7.1.6-5.4 4.7 1.6 7-6.2-3.7-6.2 3.7 1.6-7L2 9.7l7.1-.6z\"/></svg></span></div>\n      <div class=\"kicker\">Why they fell for Magyx</div>\n      <h2 class=\"section-title\">They say it better than we ever could.</h2>\n    </div>\n    <div class=\"carousel\" data-ts-carousel>\n      <article class=\"review-card\">\n        <div class=\"review-top\">\n          <div class=\"review-stars\" role=\"img\" aria-label=\"5 out of 5 stars\"><span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2.5l2.9 6.6 7.1.6-5.4 4.7 1.6 7-6.2-3.7-6.2 3.7 1.6-7L2 9.7l7.1-.6z\"/></svg></span><span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2.5l2.9 6.6 7.1.6-5.4 4.7 1.6 7-6.2-3.7-6.2 3.7 1.6-7L2 9.7l7.1-.6z\"/></svg></span><span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2.5l2.9 6.6 7.1.6-5.4 4.7 1.6 7-6.2-3.7-6.2 3.7 1.6-7L2 9.7l7.1-.6z\"/></svg></span><span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2.5l2.9 6.6 7.1.6-5.4 4.7 1.6 7-6.2-3.7-6.2 3.7 1.6-7L2 9.7l7.1-.6z\"/></svg></span><span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2.5l2.9 6.6 7.1.6-5.4 4.7 1.6 7-6.2-3.7-6.2 3.7 1.6-7L2 9.7l7.1-.6z\"/></svg></span></div>\n          <a class=\"verified\" href=\"https://se.trustpilot.com/review/magyx.co\" target=\"_blank\" rel=\"noopener\"><span class=\"tp-dot\">&#9679;</span> Trustpilot review</a>\n        </div>\n        <h3>&#8220;I've already had several compliments after wearing them.&#8221;</h3>\n        <p>What people notice first isn't the bottle or the price, but how the scent changes your presence.</p>\n        <p class=\"result-line\">Same compliments. A better price.</p>\n        <div class=\"person\"><strong>Elin Lundqvist</strong><span>Verified reviewer on Trustpilot</span></div>\n      </article>\n      <article class=\"review-card\">\n        <div class=\"review-top\">\n          <div class=\"review-stars\" role=\"img\" aria-label=\"5 out of 5 stars\"><span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2.5l2.9 6.6 7.1.6-5.4 4.7 1.6 7-6.2-3.7-6.2 3.7 1.6-7L2 9.7l7.1-.6z\"/></svg></span><span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2.5l2.9 6.6 7.1.6-5.4 4.7 1.6 7-6.2-3.7-6.2 3.7 1.6-7L2 9.7l7.1-.6z\"/></svg></span><span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2.5l2.9 6.6 7.1.6-5.4 4.7 1.6 7-6.2-3.7-6.2 3.7 1.6-7L2 9.7l7.1-.6z\"/></svg></span><span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2.5l2.9 6.6 7.1.6-5.4 4.7 1.6 7-6.2-3.7-6.2 3.7 1.6-7L2 9.7l7.1-.6z\"/></svg></span><span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2.5l2.9 6.6 7.1.6-5.4 4.7 1.6 7-6.2-3.7-6.2 3.7 1.6-7L2 9.7l7.1-.6z\"/></svg></span></div>\n          <a class=\"verified\" href=\"https://se.trustpilot.com/review/magyx.co\" target=\"_blank\" rel=\"noopener\"><span class=\"tp-dot\">&#9679;</span> Trustpilot review</a>\n        </div>\n        <h3>&#8220;It smells EXACTLY like Dior Homme Intense &#8230; almost scarily similar.&#8221;</h3>\n        <p>The dark, creamy, luxurious character you expect was there from the very first spray.</p>\n        <p class=\"result-line\">The familiar fragrance experience, without the designer price.</p>\n        <div class=\"person\"><strong>Johan Bergstr&#246;m</strong><span>Verified reviewer on Trustpilot</span></div>\n      </article>\n      <article class=\"review-card\">\n        <div class=\"review-top\">\n          <div class=\"review-stars\" role=\"img\" aria-label=\"4 out of 5 stars\"><span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2.5l2.9 6.6 7.1.6-5.4 4.7 1.6 7-6.2-3.7-6.2 3.7 1.6-7L2 9.7l7.1-.6z\"/></svg></span><span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2.5l2.9 6.6 7.1.6-5.4 4.7 1.6 7-6.2-3.7-6.2 3.7 1.6-7L2 9.7l7.1-.6z\"/></svg></span><span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2.5l2.9 6.6 7.1.6-5.4 4.7 1.6 7-6.2-3.7-6.2 3.7 1.6-7L2 9.7l7.1-.6z\"/></svg></span><span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2.5l2.9 6.6 7.1.6-5.4 4.7 1.6 7-6.2-3.7-6.2 3.7 1.6-7L2 9.7l7.1-.6z\"/></svg></span><span class=\"off\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2.5l2.9 6.6 7.1.6-5.4 4.7 1.6 7-6.2-3.7-6.2 3.7 1.6-7L2 9.7l7.1-.6z\"/></svg></span></div>\n          <a class=\"verified\" href=\"https://se.trustpilot.com/review/magyx.co\" target=\"_blank\" rel=\"noopener\"><span class=\"tp-dot\">&#9679;</span> Trustpilot review</a>\n        </div>\n        <h3>&#8220;Better than some of the most expensive perfumes you can buy.&#8221;</h3>\n        <p>The scent exceeded expectations and delivered the quality you usually associate with a much higher price.</p>\n        <p class=\"result-line\">Expensive presence. Unexpected price.</p>\n        <div class=\"person\"><strong>Moa</strong><span>Verified reviewer on Trustpilot</span></div>\n      </article>\n      <article class=\"review-card\">\n        <div class=\"review-top\">\n          <div class=\"review-stars\" role=\"img\" aria-label=\"5 out of 5 stars\"><span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2.5l2.9 6.6 7.1.6-5.4 4.7 1.6 7-6.2-3.7-6.2 3.7 1.6-7L2 9.7l7.1-.6z\"/></svg></span><span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 2.5l2.9 6.6 7.1.6-5.4 4.7 1.6 7-6.2