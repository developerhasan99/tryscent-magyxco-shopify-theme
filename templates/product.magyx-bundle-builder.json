    "massive_review_3M84NB": {
      "type": "massive-review",
      "blocks": {
        "review_zjzFRt": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/2026-07-02_16h48_27.png",
            "content": "<p>\"This is my first purchase and I'm hooked. I'll never buy perfume anywhere else again. I've never been able to find a dupe scent that actually smelled authentic and consistent.\"</p>",
            "author": "Killian P.",
            "date": "1 day ago",
            "rating": 5,
            "show_verified_badge": true,
            "product": "bergamot-sage-cedar-50-ml"
          }
        },
        "review_gHDCfL": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/Camila_Sena_Oliveira.jpg",
            "content": "<p>\"This is the best scent I've smelled in a very long time, the notes make me so happy. This will be a permanent favorite of mine forever.\"</p>",
            "author": "Jenniffer W.",
            "date": "2 days ago",
            "rating": 4,
            "show_verified_badge": true,
            "product": "3x-50ml-perfume-bottles"
          }
        },
        "review_LEfVgR": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/ugc15.png",
            "content": "<p>\"It smells really good, I loved it.\"</p>",
            "author": "Castillo B.",
            "date": "3 months ago",
            "rating": 5,
            "show_verified_badge": true,
            "product": "tryscent-collection"
          }
        },
        "review_4VMeYR": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/Carolina_Maresca_1.png",
            "content": "<p>\"All three scents I got are really good. They last long and smell like they should. The only thing I wasn't happy with was how long it took to get them. But honestly I placed a second order, so just expect a bit of a wait. Haha!<br/>\"</p>",
            "author": "Clara P.",
            "date": "2 days ago",
            "rating": 5,
            "show_verified_badge": true,
            "product": "apple-cinnamon-sandalwood"
          }
        },
        "review_mddj7q": {
          "type": "review",
          "disabled": true,
          "settings": {
            "review_image": "shopify://shop_images/dupestore_3221df98-e409-4141-82ec-bdbe62af3756.jpg",
            "content": "<p>\"I've been trying to find scents that smell exclusive and also last long, without success. This one is exactly what I was looking for..\"</p>",
            "author": "Tiana N.",
            "author_image": "shopify://shop_images/ugc15.png",
            "date": "2 days ago",
            "rating": 4,
            "show_verified_badge": true,
            "product": "fresh-escape-premium"
          }
        },
        "review_F7iC8P": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/ugc1.png",
            "content": "<p>\"Amazing brand and amazing products!\"</p>",
            "author": "Juliana B",
