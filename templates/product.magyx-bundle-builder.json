        },
        "text_Mexbpj": {
          "type": "text",
          "settings": {
            "content": "<p>We make all our perfumes to the EU's strict cosmetics standards. That means you get a product that is as safe for your skin as it is luxurious for your senses.</p><ul><li><strong>Strict safety requirements:</strong> We use only IFRA-approved ingredients, ensuring the scent is gentle and safe to wear.</li><li><strong>No cheap shortcuts:</strong> No cheap dilutions or questionable chemicals from gray zones outside Europe.</li><li><strong>Certified facilities:</strong> Every bottle is blended and filled in controlled European laboratories with full traceability.</li></ul>",
            "mobile_content": "",
