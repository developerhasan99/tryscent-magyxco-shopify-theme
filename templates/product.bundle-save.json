    "pm_bs_faq": {
      "type": "pm-bs-faq",
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "What is an inspired scent?",
            "answer": "<p>A scent with the same notes and the same scent family as a well-known perfume. It isn't the original.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "How much perfume oil do the perfumes contain?",
            "answer": "<p>20% perfume oil, the same level as an Eau de Parfum. The scent is clearly noticeable and lasts a long time without taking over.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "How long does the scent last?",
            "answer": "<p>Over 12 hours for most people. How long it lasts depends on your skin, so spray it on your skin, not your clothes.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "Can I mix different scents in a bundle?",
            "answer": "<p>Yes. Pick any scents you like, in any combination, and the same scent more than once. The price only depends on how many bottles are in the bundle.</p>"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "Where are the perfumes made?",
            "answer": "<p>In the EU.</p>"
          }
        },
        "q6": {
          "type": "question",
          "settings": {
            "question": "Why are your scents so affordable?",
            "answer": "<p>We put the money into the scent. No luxury bottles, no expensive packaging, no store rents and no pricey influencer deals. So you can smell like luxury without paying a fortune.</p>"
          }
        },
        "q7": {
          "type": "question",
          "settings": {
            "question": "When will I get my order?",
            "answer": "<p>We ship within 1-2 days. You'll see delivery times and shipping options at checkout.</p>"
          }
        },
        "q8": {
          "type": "question",
          "settings": {
            "question": "What if the scent isn't right for me?",
            "answer": "<p>You have a 60-day money-back guarantee. If the scent isn't right for you, send your order back.</p>"
          }
        },
        "q9": {
          "type": "question",
          "settings": {
            "question": "Are these original perfumes from well-known brands?",
            "answer": "<p>No. These are scents inspired by well-known compositions. MagyX has no connection to the brands mentioned and is not endorsed by them.</p>"
          }
        }
      },
