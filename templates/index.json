      "blocks": {
        "heading_ax7WWJ": {
          "type": "heading",
          "settings": {
            "content": "What does it mean when a fragrance is made in the EU?",
            "heading_type": "h2",
            "font_size": 32,
            "mobile_font_size": 24
          }
        },
        "text_gzPVkb": {
          "type": "text",
          "settings": {
            "content": "<p>We make all our perfumes to the EU's strict cosmetics standards. That means you get a product that is as safe for your skin as it is luxurious for your senses.</p><ul><li><strong>Strict safety requirements:</strong> We only use IFRA-approved ingredients, so every scent is gentle and safe to wear.</li><li><strong>No cheap shortcuts:</strong> No cheap dilutions or questionable chemicals from grey zones outside Europe.</li><li><strong>Certified facilities:</strong> Every bottle is blended and filled in controlled European laboratories with full traceability.</li></ul>",
            "mobile_content": "",
            "font_size": 18
          }
        }
      },
