    "custom_liquid_tstrust": {
      "type": "custom-liquid",
      "name": "Badges (magicperfume.co design)",
      "settings": {
        "custom_liquid": "<style>\n#ts-trust{\n  padding:40px 0;\n  background:#fff;\n  border-bottom:1px solid rgba(199,201,203,.5);\n}\n#ts-trust .ts-container{\n  width:min(1180px,calc(100% - 36px));\n  margin-inline:auto;\n}\n#ts-trust .ts-trust-grid{\n  display:grid;\n  grid-template-columns:repeat(4,1fr);\n  gap:0;\n}\n#ts-trust .ts-trust-item{\n  text-align:center;\n  padding:16px 24px;\n  border-right:1px solid rgba(199,201,203,.5);\n}\n#ts-trust .ts-trust-item:last-child{\n  border-right:none;\n}\n#ts-trust .ts-icon{\n  height:44px;\n  margin:0 auto 14px;\n  color:#184031;\n}\n#ts-trust .ts-icon svg{\n  width:36px;\n  height:36px;\n}\n#ts-trust h3{\n  margin:0 0 6px;\n  font-size:15px;\n  font-weight:800;\n  letter-spacing:.3px;\n  color:#100F0D;\n  line-height:1.3;\n}\n#ts-trust p{\n  margin:0;\n  font-size:13.5px;\n  line-height:1.6;\n  color:rgba(0,0,0,.55);\n}\n@media(max-width:700px){\n  #ts-trust{padding:24px 0}\n  #ts-trust .ts-trust-grid{\n    grid-template-columns:1fr 1fr;\n    gap:0;\n  }\n  #ts-trust .ts-trust-item{\n    padding:16px 12px;\n    border-right:1px solid rgba(199,201,203,.5);\n    border-bottom:1px solid rgba(199,201,203,.5);\n  }\n  #ts-trust .ts-trust-item:nth-child(2n){border-right:none}\n  #ts-trust .ts-trust-item:nth-last-child(-n+2){border-bottom:none}\n  #ts-trust h3{font-size:13px}\n  #ts-trust p{font-size:12.5px}\n}\n</style>\n\n<section id=\"ts-trust\">\n  <div class=\"ts-container\">\n    <div class=\"ts-trust-grid\">\n\n      <div class=\"ts-trust-item\">\n        <div class=\"ts-icon\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"4\" y=\"7.5\" width=\"16\" height=\"12.5\" rx=\"1\"/><path d=\"M4 7.5 6.5 4h11L20 7.5\"/><path d=\"M12 4v3.5\"/><path d=\"M9.5 12h5\"/></svg>\n        </div>\n        <h3>Made in Europe</h3>\n        <p>Free from phthalates and parabens. No endocrine disruptors.</p>\n      </div>\n\n      <div class=\"ts-trust-item\">\n        <div class=\"ts-icon\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3.5c3.4 4.3 5.8 7.4 5.8 10.2a5.8 5.8 0 1 1-11.6 0C6.2 10.9 8.6 7.8 12 3.5z\"/><path d=\"M9.6 14.2a2.6 2.6 0 0 0 2.3 2.5\"/></svg>\n        </div>\n        <h3>High-concentration eau de parfum</h3>\n        <p>20% perfume oil from Grasse, France, in every scent.</p>\n      </div>\n\n      <div class=\"ts-trust-item\">\n        <div class=\"ts-icon\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"6.5\" y=\"9.5\" width=\"11\" height=\"10.5\" rx=\"1.5\"/><path d=\"M10.5 9.5V7h3v2.5\"/><rect x=\"9.5\" y=\"3.8\" width=\"5\" height=\"3.2\" rx=\".8\"/></svg>\n        </div>\n        <h3>Developed by perfume experts</h3>\n        <p>By the people behind well-known brands. Over 80 scents to choose from.</p>\n      </div>\n\n      <div class=\"ts-trust-item\">\n        <div class=\"ts-icon\" aria-hidden=\"true\">\n          <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3.5 19 6v5.4c0 4.4-2.9 7.7-7 9.1-4.1-1.4-7-4.7-7-9.1V6z\"/><path d=\"m9 11.9 2.2 2.2 3.8-4.2\"/></svg>\n        </div>\n        <h3>Try it for 60 days</h3>\n        <p>Not your scent? Return it within 60 days.</p>\n      </div>\n\n    </div>\n  </div>\n</section>",
        "color_scheme": "scheme-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
