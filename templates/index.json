        "review_kCUEm4": {
          "type": "review",
          "settings": {
            "heading": "Arrived perfectly.",
            "content": "<p>The product was well packaged, arrived in excellent condition and the scent quality exceeded my expectations. Very happy with this purchase.</p>",
