        "review_KkRLfy": {
          "type": "review",
          "settings": {
            "content": "<p>\"I'm really into cologne so I'm pretty picky when it comes to clones, but TryScent completely won me over. I first ordered the Sauvage clone from the homepage and recognized the scent immediately when I sprayed it. Now I own four TryScent scents in total and I love them all. I also have three more on the way thanks to their bundle deals. If you want something that works on a budget and delivers designer-level performance, I can't recommend them enough.\"</p>",
            "author": "Astrid",
            "date": "4 months ago",
            "rating": 5,
            "show_verified_badge": true,
            "product": "fresh-escape-premium"
          }
        },
        "review_UfaJJE": {
