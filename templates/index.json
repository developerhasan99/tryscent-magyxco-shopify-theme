        "review_iPjTCz": {
          "type": "review",
          "settings": {
            "content": "<p>\"At first I was worried because the delivery was a bit delayed, but once I got them I was completely blown away by the scent. Once it settles, oh my god, it's just amazing.\"</p>",
            "author": "Lionel M.",
