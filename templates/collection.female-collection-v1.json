      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<!-- Magyx LP22 — light hero + four benefit blocks. Custom Liquid paste block.\n     Self-contained: egna klasser (ts-h22-*), egen CSS, ingen Liquid-tagg.\n     Bild: Shopify Files → magyx-lp22-hero-bright.jpg (2560x1429, uppladdad 19.08.2026) -->\n\n<div class=\"ts-h22\">\n  <section class=\"ts-h22-hero\">\n    <div class=\"ts-h22-inner\">\n      <p class=\"ts-h22-eyebrow\"><span>&#9733;&#9733;&#9733;&#9733;&#9733;</span> Loved by 10,000 customers</p>\n      <h1>An elegant impression.</h1>\n      <p class=\"ts-h22-sub\">The right scent lingers long after you've left.</p>\n    </div>\n  </section>\n\n  <section class=\"ts-h22-feats\">\n    <div class=\"ts-h22-inner ts-h22-grid\">\n      <div class=\"ts-h22-feat\">\n        <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 7h16v12H4z\"/><path d=\"M4 7l2-3h12l2 3\"/><path d=\"M10 11h4\"/></svg>\n        <h3>Made in Europe</h3>\n        <p>Produced to strict European perfume standards.</p>\n      </div>\n      <div class=\"ts-h22-feat\">\n        <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 3s6 6.5 6 10.5A6 6 0 0 1 6 13.5C6 9.5 12 3 12 3z\"/></svg>\n        <h3>21% fragrance concentration</h3>\n        <p>Made to be noticed all day.</p>\n      </div>\n      <div class=\"ts-h22-feat\">\n        <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 3l8 3v6c0 4.5-3.2 7.8-8 9-4.8-1.2-8-4.5-8-9V6l8-3z\"/><path d=\"M9 12l2.2 2.2L15.5 10\"/></svg>\n        <h3>60-day guarantee</h3>\n        <p>Try the perfume at home. If it's not right for you, you have 60 days to return it.</p>\n      </div>\n      <div class=\"ts-h22-feat\">\n        <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5.2l3.2 2\"/></svg>\n        <h3>Long-lasting scent</h3>\n        <p>Made to stay noticeable for up to 12 hours.</p>\n      </div>\n    </div>\n  </section>\n</div>\n\n<style>\n  .ts-h22{\n    --ts-ink:#1a1418;\n    --ts-muted:#6b6169;\n    --ts-rose:#9c4a6b;\n    width:100vw;\n    margin-left:calc(50% - 50vw);\n    font-family:system-ui,-apple-system,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif;\n  }\n  .ts-h22 *{box-sizing:border-box}\n  .ts-h22-inner{\n    max-width:1200px;\n    margin:0 auto;\n    padding:0 24px;\n  }\n\n  /* ---------- hero ---------- */\n  .ts-h22-hero{\n    position:relative;\n    display:flex;\n    align-items:center;\n    height:clamp(430px,34vw,560px);\n    background-color:#eef4f8;\n    background-image:url('https://cdn.shopify.com/s/files/1/0086/7932/5753/files/magyx-lp22-hero-bright.jpg?v=1787183752');\n    background-size:cover;\n    background-position:center 16%;   /* focal point - holds her face in frame */\n    background-repeat:no-repeat;\n  }\n  /* white wash as its own layer so mobile can flip its direction\n     without repeating the image URL */\n  .ts-h22-hero::before{\n    content:\"\";\n    position:absolute;\n    inset:0;\n    background:linear-gradient(90deg,rgba(255,255,255,.92),rgba(255,255,255,.55) 45%,rgba(255,255,255,0) 70%);\n  }\n  /* hero is a flex container - without this the inner shrinks to content and the copy drifts centre */\n  .ts-h22-hero .ts-h22-inner{position:relative;z-index:1;width:100%}\n  .ts-h22-eyebrow{\n    margin:0 0 10px;\n    font-size:12px;\n    font-weight:600;\n    letter-spacing:.14em;\n    text-transform:uppercase;\n    color:var(--ts-rose);\n  }\n  .ts-h22-eyebrow span{letter-spacing:.06em;margin-right:6px}\n  .ts-h22-hero h1{\n    margin:0 0 12px;\n    font-family:Georgia,\"Times New Roman\",serif;   /* swap for the theme heading font */\n    font-weight:400;\n    font-size:clamp(30px,3.1vw,50px);\n    line-height:1.08;\n    letter-spacing:-.01em;\n    color:var(--ts-ink);\n  }\n  .ts-h22-sub{\n    margin:0;\n    max-width:520px;\n    font-size:clamp(15px,1.05vw,17px);\n    line-height:1.5;\n    color:var(--ts-ink);\n  }\n\n  /* ---------- four feature blocks ---------- */\n  .ts-h22-feats{background:#fff;padding:44px 0 40px}\n  .ts-h22-grid{\n    display:grid;\n    grid-template-columns:repeat(4,1fr);\n    gap:34px;\n    text-align:center;\n  }\n  .ts-h22-feat svg{\n    width:30px;height:30px;\n    fill:none;stroke:var(--ts-ink);\n    stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;\n    margin-bottom:14px;\n  }\n  .ts-h22-feat h3{\n    margin:0 0 8px;\n    font-size:17px;\n    font-weight:700;\n    letter-spacing:-.01em;\n    color:var(--ts-ink);\n  }\n  .ts-h22-feat p{\n    margin:0;\n    font-size:14px;\n    line-height:1.55;\n    color:var(--ts-muted);\n  }\n\n  /* ---------- responsive ---------- */\n  @media(max-width:900px){\n    .ts-h22-grid{grid-template-columns:repeat(2,1fr);gap:28px}\n  }\n  @media(max-width:640px){\n    /* stacked: photo on top, copy below her - otherwise the text lands on her face */\n    .ts-h22-hero{\n      height:auto;\n      min-height:600px;\n      align-items:flex-end;\n      padding:0 0 34px;\n      background-position:74% top;\n    }\n    .ts-h22-hero::before{\n      background:linear-gradient(180deg,\n        rgba(255,255,255,0) 38%,\n        rgba(255,255,255,.80) 58%,\n        rgba(255,255,255,.96) 74%,\n        #fff 100%);\n    }\n    .ts-h22-sub{max-width:none}\n  }\n  @media(max-width:520px){\n    .ts-h22-grid{grid-template-columns:1fr}\n  }\n</style>",
