{%- comment -%}
  mgx-shipping-badges (magyx.co): three tiles with hairline dividers under the payment icons of the Bundle & Save
  box, same layout as magicperfume.co / aaroma.co fmx-shipping-badges (28px media slot over a 12/13px semibold line).
  - delivery: solid truck (assets/mgx-icon-truck.svg = magicperfume's) + where orders ship from;
  - carrier: FedEx + UPS logos (assets/mgx-fedex-logo.svg = Wikimedia Commons "FedEx Corporation - 2016 Logo.svg"
    cropped to the wordmark, assets/mgx-ups-logo.svg = "United Parcel Service logo 2014.svg");
  - guarantee: magicperfume's green seal (assets/mgx-guarantee-badge.png).
  Carrier per country (logos from the sister stores): PostNord in SE/DK/FI/NO/IS (tryscent.co fmx-logo-postnord),
  InPost + DPD in PL (tryscent.eu inpost-logo, magicperfume.co logo-dpd), PostNL in NL (aaroma.co fmx-postnl-logo),
  FedEx + UPS everywhere else. The server picks by localization.country (PL and SE are markets here). NL, DK, FI,
  NO and IS are not, so those visitors browse another market: the script below then reads the visitor's country
  from the Server-Timing header Shopify's edge writes (same source as snippets/location-popup.liquid; ?geo_test=XX
  overrides it for QA) and shows that country's carrier.
  Renders nothing for a product that ships nothing, or when all three texts are empty.

  Accepts:
  - product: {Object} the product being bought (optional)
  - delivery_text, carrier_text, guarantee_text: {String} tile texts (an empty text drops its tile)

  Usage:
  {% render 'mgx-shipping-badges', product: product, delivery_text: '...', carrier_text: '...', guarantee_text: '...' %}
{%- endcomment -%}
{%- liquid
  assign badge_ships = true
  if product != blank and product.selected_or_first_available_variant.requires_shipping == false
    assign badge_ships = false
  endif
  if delivery_text == blank and carrier_text == blank and guarantee_text == blank
    assign badge_ships = false
  endif
  assign badge_carrier = 'default'
  case localization.country.iso_code
    when 'SE', 'DK', 'FI', 'NO', 'IS'
      assign badge_carrier = 'postnord'
    when 'PL'
      assign badge_carrier = 'pl'
    when 'NL'
      assign badge_carrier = 'postnl'
  endcase
-%}
{%- if badge_ships -%}
  <style>
    .mgx-shipping-badges { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); margin: 24px 0; color: var(--pm-ink, #121212); }
    .mgx-shipping-badges__item { display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 4px 6px; text-align: center; }
    .mgx-shipping-badges__item + .mgx-shipping-badges__item { border-left: 1px solid var(--pm-line, #e7e7e7); }
    .mgx-shipping-badges__media { display: flex; align-items: center; justify-content: center; gap: 8px; width: 100%; height: 28px; }
    .mgx-shipping-badges__icon { display: block; width: 28px; height: 28px; }
    .mgx-shipping-badges__icon svg { display: block; width: 100%; height: 100%; fill: currentColor; }
    .mgx-shipping-badges__logo { display: block; width: auto; height: 28px; }
    .mgx-shipping-badges__logo--fedex { height: 18px; }
    .mgx-shipping-badges__logo--ups { height: 26px; }
    .mgx-shipping-badges__logo--postnord { height: 18px; max-width: 100%; }
    .mgx-shipping-badges__logo--inpost { height: 28px; }
    .mgx-shipping-badges__logo--dpd { height: 22px; }
    .mgx-shipping-badges__logo--postnl { height: 28px; }
    .mgx-shipping-badges__carrier { display: contents; }
    .mgx-shipping-badges__carrier[hidden] { display: none; }
    .mgx-shipping-badges__text { font-size: 12px; line-height: 1.3; font-weight: 600; letter-spacing: 0; overflow-wrap: anywhere; }
    @media (min-width: 750px) {
      .mgx-shipping-badges__item { padding: 4px 10px; }
      .mgx-shipping-badges__text { font-size: 13px; }
    }
  </style>
  <div class="mgx-shipping-badges">
    {%- if delivery_text != blank -%}
      <div class="mgx-shipping-badges__item">
        <span class="mgx-shipping-badges__media">
          <span class="mgx-shipping-badges__icon" aria-hidden="true">{{ 'mgx-icon-truck.svg' | inline_asset_content }}</span>
        </span>
        <span class="mgx-shipping-badges__text">{{ delivery_text | escape }}</span>
      </div>
    {%- endif -%}
    {%- if carrier_text != blank -%}
      <div class="mgx-shipping-badges__item" data-mgx-carrier>
        <div class="mgx-shipping-badges__carrier" data-carrier="postnord"{% unless badge_carrier == 'postnord' %} hidden{% endunless %}>
          <span class="mgx-shipping-badges__media">
            <img class="mgx-shipping-badges__logo mgx-shipping-badges__logo--postnord" src="{{ 'mgx-postnord-logo.svg' | asset_url }}" alt="PostNord" width="95" height="18" loading="lazy">
          </span>
          <span class="mgx-shipping-badges__text">Secure shipping with PostNord</span>
        </div>
        <div class="mgx-shipping-badges__carrier" data-carrier="pl"{% unless badge_carrier == 'pl' %} hidden{% endunless %}>
          <span class="mgx-shipping-badges__media">
            <img class="mgx-shipping-badges__logo mgx-shipping-badges__logo--inpost" src="{{ 'mgx-inpost-logo.svg' | asset_url }}" alt="InPost" width="47" height="28" loading="lazy">
            <img class="mgx-shipping-badges__logo mgx-shipping-badges__logo--dpd" src="{{ 'mgx-dpd-logo.svg' | asset_url }}" alt="DPD" width="52" height="22" loading="lazy">
          </span>
          <span class="mgx-shipping-badges__text">Secure shipping with InPost &amp; DPD</span>
        </div>
        <div class="mgx-shipping-badges__carrier" data-carrier="postnl"{% unless badge_carrier == 'postnl' %} hidden{% endunless %}>
          <span class="mgx-shipping-badges__media">
            <img class="mgx-shipping-badges__logo mgx-shipping-badges__logo--postnl" src="{{ 'mgx-postnl-logo.svg' | asset_url }}" alt="PostNL" width="28" height="28" loading="lazy">
          </span>
          <span class="mgx-shipping-badges__text">Secure shipping with PostNL</span>
        </div>
        <div class="mgx-shipping-badges__carrier" data-carrier="default"{% unless badge_carrier == 'default' %} hidden{% endunless %}>
        <span class="mgx-shipping-badges__media">
          <img
            class="mgx-shipping-badges__logo mgx-shipping-badges__logo--fedex"
            src="{{ 'mgx-fedex-logo.svg' | asset_url }}"
            alt="FedEx"
            width="61"
            height="18"
            loading="lazy">
          <img
            class="mgx-shipping-badges__logo mgx-shipping-badges__logo--ups"
            src="{{ 'mgx-ups-logo.svg' | asset_url }}"
            alt="UPS"
            width="22"
            height="26"
            loading="lazy">
        </span>
        <span class="mgx-shipping-badges__text">{{ carrier_text | escape }}</span>
        </div>
      </div>
      {%- if badge_carrier == 'default' -%}
        <script>
          (function () {
            var MAP = { SE: 'postnord', DK: 'postnord', FI: 'postnord', NO: 'postnord', IS: 'postnord', PL: 'pl', NL: 'postnl' };
            var code = null;
            try { code = sessionStorage.getItem('mgx_geo_test'); } catch (e) {}
            try {
              var q = new URLSearchParams(location.search).get('geo_test');
              if (q) code = q;
            } catch (e) {}
            if (!code) {
              try {
                var nav = performance.getEntriesByType('navigation')[0];
                var entry = nav && nav.serverTiming ? Array.prototype.find.call(nav.serverTiming, function (t) { return t.name === 'country'; }) : null;
                code = entry ? entry.description : null;
              } catch (e) {}
            }
            var key = MAP[String(code || '').toUpperCase()];
            if (!key) return;
            document.querySelectorAll('[data-mgx-carrier]').forEach(function (tile) {
              tile.querySelectorAll('[data-carrier]').forEach(function (group) {
                group.hidden = group.getAttribute('data-carrier') !== key;
              });
            });
          })();
        </script>
      {%- endif -%}
    {%- endif -%}
    {%- if guarantee_text != blank -%}
      <div class="mgx-shipping-badges__item">
        <span class="mgx-shipping-badges__media">
          <img
            class="mgx-shipping-badges__logo"
            src="{{ 'mgx-guarantee-badge.png' | asset_url }}"
            alt=""
            width="28"
            height="28"
            loading="lazy">
        </span>
        <span class="mgx-shipping-badges__text">{{ guarantee_text | escape }}</span>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}
