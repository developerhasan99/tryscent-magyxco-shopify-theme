{% comment %}
  Outline trust icons (24px grid, 1.6 stroke, currentColor), same set as the Whop store's trust row.
  Usage: {% render 'trust-icon', name: 'shield' %}  — box, bottle, drop, shield, clock, truck.
{% endcomment %}
{%- capture paths -%}
  {%- case name -%}
    {%- when 'box' -%}
      <rect x="4" y="7.5" width="16" height="12.5" rx="1"/><path d="M4 7.5 6.5 4h11L20 7.5"/><path d="M12 4v3.5"/><path d="M9.5 12h5"/>
    {%- when 'bottle' -%}
      <rect x="6.5" y="9.5" width="11" height="10.5" rx="1.5"/><path d="M10.5 9.5V7h3v2.5"/><rect x="9.5" y="3.8" width="5" height="3.2" rx=".8"/>
    {%- when 'drop' -%}
      <path d="M12 3.5c3.4 4.3 5.8 7.4 5.8 10.2a5.8 5.8 0 1 1-11.6 0C6.2 10.9 8.6 7.8 12 3.5z"/><path d="M9.6 14.2a2.6 2.6 0 0 0 2.3 2.5"/>
    {%- when 'shield' -%}
      <path d="M12 3.5 19 6v5.4c0 4.4-2.9 7.7-7 9.1-4.1-1.4-7-4.7-7-9.1V6z"/><path d="m9 11.9 2.2 2.2 3.8-4.2"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>
    {%- when 'truck' -%}
      <path d="M3.5 6.5h10.5V16H3.5z"/><path d="M14 9.5h3.4l3.1 3.3V16H14"/><circle cx="7.5" cy="17.6" r="1.6"/><circle cx="17" cy="17.6" r="1.6"/>
  {%- endcase -%}
{%- endcapture -%}
{%- if paths != blank -%}
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    {{- paths -}}
  </svg>
{%- endif -%}
