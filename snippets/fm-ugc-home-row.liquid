{% comment %}
  Homepage UGC video row ("Loved by thousands"), rendered by sections/fm-home-tabs.liquid (setting "Show the UGC
  video row"). Port of tryscent.co's fuel05-ugc-home-row (renamed fm-ugc-home-row so magyx.co's own
  fuel05-ugc-home-row, used by the collection grid build, stays untouched).

  magyx.co clips (Files, "magyx_co_english_only_*"), same seven in the desktop and the phone build.
  Videos only: no product pill under the clips (bundle pills taken off 17.11.2026; pass product_item to bring one back).
  A snippet has no settings to hold a video pick, so the URLs are hard-coded (480p renditions, Files previews).

  Usage:
  {% render 'fm-ugc-home-row' %}
{% endcomment %}

{{ 'fm-ugc.css' | asset_url | stylesheet_tag }}
<script src="{{ 'fm-ugc.js' | asset_url }}" defer="defer"></script>

{%- capture fuel05_home_header -%}
    <div class="fuel05-ugc__header">
      <h2 class="fuel05-ugc__heading">Loved by thousands</h2>
      <div class="fuel05-ugc__nav">
        <button class="fuel05-ugc__arrow fuel05-ugc__arrow--prev" type="button" aria-label="Previous">
          <svg preserveAspectRatio="none" overflow="visible" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 4L17 12L9 20" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button class="fuel05-ugc__arrow fuel05-ugc__arrow--next" type="button" aria-label="Next">
          <svg preserveAspectRatio="none" overflow="visible" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 4L17 12L9 20" stroke="black" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </div>
{%- endcapture -%}

<div
  class="fuel05-ugc fuel05-ugc--home fuel05-ugc--home-desktop"
  data-fuel05-row
  data-gap-mobile="10"
  data-gap-desktop="32">
