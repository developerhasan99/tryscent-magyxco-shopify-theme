{%- comment -%}
  Icon for one cell of the stacks-up comparison table.
  Accepts: kind ('yes' | 'partial' | 'no')
{%- endcomment -%}
{%- case kind -%}
  {%- when 'yes' -%}
    <svg class="mgx-cmp__icon" role="img" aria-label="Yes" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="12" cy="12" r="10" fill="var(--mgx-amber)"/>
      <path d="M7.5 12.5l3 3 6-6.5" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  {%- when 'partial' -%}
    <svg class="mgx-cmp__icon" role="img" aria-label="Partly" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="12" cy="12" r="9" stroke="var(--mgx-graphite)" stroke-width="2"/>
      <path d="M8 12h8" stroke="var(--mgx-graphite)" stroke-width="2" stroke-linecap="round"/>
    </svg>
  {%- else -%}
    <svg class="mgx-cmp__icon" role="img" aria-label="No" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <circle cx="12" cy="12" r="9" stroke="var(--mgx-graphite)" stroke-width="2"/>
      <path d="M9 15l6-6M15 15L9 9" stroke="var(--mgx-graphite)" stroke-width="2" stroke-linecap="round"/>
    </svg>
{%- endcase -%}
